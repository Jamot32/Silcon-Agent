# Server-only. Never prefix this key with NEXT_PUBLIC_.
LLM_PROVIDER=codex
# Codex uses the host's existing `codex login` (ChatGPT-plan OAuth).
# No OAuth token belongs in this file. Empty model selects gpt-6.1-sol.
CODEX_MODEL=
LLM_MAX_CALLS=50
LLM_MAX_TOKENS=300000
# Set LLM_PROVIDER=meta and configure this key for the competition switch.
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
META_REASONING_EFFORT=medium
RUN_BUDGET_USD=2
DATABASE_URL=sqlite:////data/silicon-agent.db
RUNS_DIR=/data
