id: 1096
event: file_written
data: {"id":1096,"ts":"2026-10-23T23:19:57.922763+00:00","type":"file_written","payload":{"path":"test/test_uart_spec.py","bytes":3265,"diff":"--- test/test_uart_spec.py\n+++ test/test_uart_spec.py\n@@ -0,0 +1,145 @@\n+import cocotb\n+from cocotb.triggers import Timer\n+\n+\n+DIV = 16\n+\n+\n+async def tick(dut):\n+    dut.clk.value = 0\n+    await Timer(5, unit='ns')\n+    dut.clk.value = 1\n+    await Timer(5, unit='ns')\n+\n+\n+def check(dut, tx, busy):\n+    assert int(dut.tx.value) == tx, 'Incorrect serial output'\n+    assert int(dut.busy.value) == busy, 'Incorrect busy state'\n+\n+\n+async def reset(dut):\n+    dut.clk.value = 0\n+    dut.start.value = 0\n+    dut.data_in.value = 0\n+    dut.rst_n.value = 0\n+    await tick(dut)\n+    check(dut, 1, 0)\n+    dut.rst_n.value = 1\n+\n+\n+async def accept(dut, byte):\n+    dut.data_in.value = byte\n+    dut.start.value = 1\n+    await tick(dut)\n+    check(dut, 0, 1)\n+    dut.start.value = 0\n+\n+\n+def serial_bit(byte, age):\n+    slot = age // DIV\n+    if slot == 0:\n+        return 0\n+    if slot == 9:\n+        return 1\n+    return (byte >> (slot - 1)) & 1\n+\n+\n+async def finish(dut, byte):\n+    for age in range(1, 10 * DIV):\n+        await tick(dut)\n+        check(dut, serial_bit(byte, age), 1)\n+    await tick(dut)\n+    check(dut, 1, 0)\n+\n+\n+@cocotb.test()\n+async def a5_exact_timing(dut):\n+    await reset(dut)\n+    for _ in range(3):\n+        await tick(dut)\n+        check(dut, 1, 0)\n+    await accept(dut, 0xA5)\n+    await finish(dut, 0xA5)\n+    for _ in range(3):\n+        await tick(dut)\n+        check(dut, 1, 0)\n+\n+\n+@cocotb.test()\n+async def zero_and_ff_framing(dut):\n+    await reset(dut)\n+    for byte in (0x00, 0xFF):\n+        await accept(dut, byte)\n+        await finish(dut, byte)\n+        for _ in range(2 * DIV):\n+            await tick(dut)\n+            check(dut, 1, 0)\n+\n+\n+@cocotb.test()\n+async def synchronous_reset_priority_and_abort(dut):\n+    await reset(dut)\n+    dut.clk.value = 0\n+    dut.start.value = 1\n+    dut.rst_n.value = 0\n+    await Timer(5, unit='ns')\n+    check(dut, 1, 0)\n+    await tick(dut)\n+    check(dut, 1, 0)\n+    dut.start.value = 0\n+    dut.rst_n.value = 1\n+    await accept(dut, 0x00)\n+    for _ in range(2 * DIV):\n+        await tick(dut)\n+        check(dut, 0, 1)\n+    dut.clk.value = 0\n+    await Timer(5, unit='ns')\n+    dut.rst_n.value = 0\n+    dut.start.value = 1\n+    await Timer(5, unit='ns')\n+    check(dut, 0, 1)\n+    await tick(dut)\n+    check(dut, 1, 0)\n+    dut.start.value = 0\n+    dut.rst_n.value = 1\n+    for _ in range(11 * DIV):\n+        await tick(dut)\n+        check(dut, 1, 0)\n+    await accept(dut, 0x96)\n+    await finish(dut, 0x96)\n+\n+\n+@cocotb.test()\n+async def busy_requests_ignored_and_not_queued(dut):\n+    await reset(dut)\n+    await accept(dut, 0x69)\n+    for age in range(1, 10 * DIV + 1):\n+        dut.data_in.value = (age * 37) & 255\n+        dut.start.value = int(age in (1, DIV, 4 * DIV, 9 * DIV, 10 * DIV))\n+        await tick(dut)\n+        if age < 10 * DIV:\n+            check(dut, serial_bit(0x69, age), 1)\n+        else:\n+            check(dut, 1, 0)\n+    dut.start.value = 0\n+    for _ in range(11 * DIV):\n+        await tick(dut)\n+        check(dut, 1, 0)\n+\n+\n+@cocotb.test()\n+async def held_request_restarts_after_completion(dut):\n+    await reset(dut)\n+    await accept(dut, 0x35)\n+    dut.start.value = 1\n+    dut.data_in.value = 0xFF\n+    await finish(dut, 0x35)\n+    dut.data_in.value = 0xCA\n+    await tick(dut)\n+    check(dut, 0, 1)\n+    dut.start.value = 0\n+    dut.data_in.value = 0x00\n+    await finish(dut, 0xCA)\n+    for _ in range(3):\n+        await tick(dut)\n+        check(dut, 1, 0)\n","content":"import cocotb\nfrom cocotb.triggers import Timer\n\n\nDIV = 16\n\n\nasync def tick(dut):\n    dut.clk.value = 0\n    await Timer(5, unit='ns')\n    dut.clk.value = 1\n    await Timer(5, unit='ns')\n\n\ndef check(dut, tx, busy):\n    assert int(dut.tx.value) == tx, 'Incorrect serial output'\n    assert int(dut.busy.value) == busy, 'Incorrect busy state'\n\n\nasync def reset(dut):\n    dut.clk.value = 0\n    dut.start.value = 0\n    dut.data_in.value = 0\n    dut.rst_n.value = 0\n    await tick(dut)\n    check(dut, 1, 0)\n    dut.rst_n.value = 1\n\n\nasync def accept(dut, byte):\n    dut.data_in.value = byte\n    dut.start.value = 1\n    await tick(dut)\n    check(dut, 0, 1)\n    dut.start.value = 0\n\n\ndef serial_bit(byte, age):\n    slot = age // DIV\n    if slot == 0:\n        return 0\n    if slot == 9:\n        return 1\n    return (byte >> (slot - 1)) & 1\n\n\nasync def finish(dut, byte):\n    for age in range(1, 10 * DIV):\n        await tick(dut)\n        check(dut, serial_bit(byte, age), 1)\n    await tick(dut)\n    check(dut, 1, 0)\n\n\n@cocotb.test()\nasync def a5_exact_timing(dut):\n    await reset(dut)\n    for _ in range(3):\n        await tick(dut)\n        check(dut, 1, 0)\n    await accept(dut, 0xA5)\n    await finish(dut, 0xA5)\n    for _ in range(3):\n        await tick(dut)\n        check(dut, 1, 0)\n\n\n@cocotb.test()\nasync def zero_and_ff_framing(dut):\n    await reset(dut)\n    for byte in (0x00, 0xFF):\n        await accept(dut, byte)\n        await finish(dut, byte)\n        for _ in range(2 * DIV):\n            await tick(dut)\n            check(dut, 1, 0)\n\n\n@cocotb.test()\nasync def synchronous_reset_priority_and_abort(dut):\n    await reset(dut)\n    dut.clk.value = 0\n    dut.start.value = 1\n    dut.rst_n.value = 0\n    await Timer(5, unit='ns')\n    check(dut, 1, 0)\n    await tick(dut)\n    check(dut, 1, 0)\n    dut.start.value = 0\n    dut.rst_n.value = 1\n    await accept(dut, 0x00)\n    for _ in range(2 * DIV):\n        await tick(dut)\n        check(dut, 0, 1)\n    dut.clk.value = 0\n    await Timer(5, unit='ns')\n    dut.rst_n.value = 0\n    dut.start.value = 1\n    await Timer(5, unit='ns')\n    check(dut, 0, 1)\n    await tick(dut)\n    check(dut, 1, 0)\n    dut.start.value = 0\n    dut.rst_n.value = 1\n    for _ in range(11 * DIV):\n        await tick(dut)\n        check(dut, 1, 0)\n    await accept(dut, 0x96)\n    await finish(dut, 0x96)\n\n\n@cocotb.test()\nasync def busy_requests_ignored_and_not_queued(dut):\n    await reset(dut)\n    await accept(dut, 0x69)\n    for age in range(1, 10 * DIV + 1):\n        dut.data_in.value = (age * 37) & 255\n        dut.start.value = int(age in (1, DIV, 4 * DIV, 9 * DIV, 10 * DIV))\n        await tick(dut)\n        if age < 10 * DIV:\n            check(dut, serial_bit(0x69, age), 1)\n        else:\n            check(dut, 1, 0)\n    dut.start.value = 0\n    for _ in range(11 * DIV):\n        await tick(dut)\n        check(dut, 1, 0)\n\n\n@cocotb.test()\nasync def held_request_restarts_after_completion(dut):\n    await reset(dut)\n    await accept(dut, 0x35)\n    dut.start.value = 1\n    dut.data_in.value = 0xFF\n    await finish(dut, 0x35)\n    dut.data_in.value = 0xCA\n    await tick(dut)\n    check(dut, 0, 1)\n    dut.start.value = 0\n    dut.data_in.value = 0x00\n    await finish(dut, 0xCA)\n    for _ in range(3):\n        await tick(dut)\n        check(dut, 1, 0)\n"}}

id: 1097
event: tool_finished
data: {"id":1097,"ts":"2026-10-23T23:19:57.931661+00:00","type":"tool_finished","payload":{"tool":"write_file","tool_call_id":"write_uart_tests","result":{"ok":true,"bytes":3265,"diff":"--- test/test_uart_spec.py\n+++ test/test_uart_spec.py\n@@ -0,0 +1,145 @@\n+import cocotb\n+from cocotb.triggers import Timer\n+\n+\n+DIV = 16\n+\n+\n+async def tick(dut):\n+    dut.clk.value = 0\n+    await Timer(5, unit='ns')\n+    dut.clk.value = 1\n+    await Timer(5, unit='ns')\n+\n+\n+def check(dut, tx, busy):\n+    assert int(dut.tx.value) == tx, 'Incorrect serial output'\n+    assert int(dut.busy.value) == busy, 'Incorrect busy state'\n+\n+\n+async def reset(dut):\n+    dut.clk.value = 0\n+    dut.start.value = 0\n+    dut.data_in.value = 0\n+    dut.rst_n.value = 0\n+    await tick(dut)\n+    check(dut, 1, 0)\n+    dut.rst_n.value = 1\n+\n+\n+async def accept(dut, byte):\n+    dut.data_in.value = byte\n+    dut.start.value = 1\n+    await tick(dut)\n+    check(dut, 0, 1)\n+    dut.start.value = 0\n+\n+\n+def serial_bit(byte, age):\n+    slot = age // DIV\n+    if slot == 0:\n+        return 0\n+    if slot == 9:\n+        return 1\n+    return (byte >> (slot - 1)) & 1\n+\n+\n+async def finish(dut, byte):\n+    for age in range(1, 10 * DIV):\n+        await tick(dut)\n+        check(dut, serial_bit(byte, age), 1)\n+    await tick(dut)\n+    check(dut, 1, 0)\n+\n+\n+@cocotb.test()\n+async def a5_exact_timing(dut):\n+    await reset(dut)\n+    for _ in range(3):\n+        await tick(dut)\n+        check(dut, 1, 0)\n+    await accept(dut, 0xA5)\n+    await finish(dut, 0xA5)\n+    for _ in range(3):\n+        await tick(dut)\n+        check(dut, 1, 0)\n+\n+\n+@cocotb.test()\n+async def zero_and_ff_framing(dut):\n+    await reset(dut)\n+    for byte in (0x00, 0xFF):\n+        await accept(dut, byte)\n+        await finish(dut, byte)\n+        for _ in range(2 * DIV):\n+            await tick(dut)\n+            check(dut, 1, 0)\n+\n+\n+@cocotb.test()\n+async def synchronous_reset_priority_and_abort(dut):\n+    await reset(dut)\n+    dut.clk.value = 0\n+    dut.start.value = 1\n+    dut.rst_n.value = 0\n+    await Timer(5, unit='ns')\n+    check(dut, 1, 0)\n+    await tick(dut)\n+    check(dut, 1, 0)\n+    dut.start.value = 0\n+    dut.rst_n.value = 1\n+    await accept(dut, 0x00)\n+    for _ in range(2 * DIV):\n+        await tick(dut)\n+        check(dut, 0, 1)\n+    dut.clk.value = 0\n+    await Timer(5, unit='ns')\n+    dut.rst_n.value = 0\n+    dut.start.value = 1\n+    await Timer(5, unit='ns')\n+    check(dut, 0, 1)\n+    await tick(dut)\n+    check(dut, 1, 0)\n+    dut.start.value = 0\n+    dut.rst_n.value = 1\n+    for _ in range(11 * DIV):\n+        await tick(dut)\n+        check(dut, 1, 0)\n+    await accept(dut, 0x96)\n+    await finish(dut, 0x96)\n+\n+\n+@cocotb.test()\n+async def busy_requests_ignored_and_not_queued(dut):\n+    await reset(dut)\n+    await accept(dut, 0x69)\n+    for age in range(1, 10 * DIV + 1):\n+        dut.data_in.value = (age * 37) & 255\n+        dut.start.value = int(age in (1, DIV, 4 * DIV, 9 * DIV, 10 * DIV))\n+        await tick(dut)\n+        if age < 10 * DIV:\n+            check(dut, serial_bit(0x69, age), 1)\n+        else:\n+            check(dut, 1, 0)\n+    dut.start.value = 0\n+    for _ in range(11 * DIV):\n+        await tick(dut)\n+        check(dut, 1, 0)\n+\n+\n+@cocotb.test()\n+async def held_request_restarts_after_completion(dut):\n+    await reset(dut)\n+    await accept(dut, 0x35)\n+    dut.start.value = 1\n+    dut.data_in.value = 0xFF\n+    await finish(dut, 0x35)\n+    dut.data_in.value = 0xCA\n+    await tick(dut)\n+    check(dut, 0, 1)\n+    dut.start.value = 0\n+    dut.data_in.value = 0x00\n+    await finish(dut, 0xCA)\n+    for _ in range(3):\n+        await tick(dut)\n+        check(dut, 1, 0)\n"}}}

