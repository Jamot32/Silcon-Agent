id: 1088
event: file_written
data: {"id":1088,"ts":"2026-10-23T23:19:20.868419+00:00","type":"file_written","payload":{"path":"src/uart_tx.v","bytes":1825,"diff":"--- src/uart_tx.v\n+++ src/uart_tx.v\n@@ -0,0 +1,64 @@\n+module uart_tx #(\n+    parameter integer BAUD_DIV = 16\n+) (\n+    input wire clk,\n+    input wire rst_n,\n+    input wire [7:0] data_in,\n+    input wire start,\n+    output reg tx,\n+    output reg busy\n+);\n+\n+    function integer counter_width;\n+        input integer divisor;\n+        integer value;\n+        begin\n+            value = divisor - 1;\n+            counter_width = 0;\n+            while (value > 0) begin\n+                counter_width = counter_width + 1;\n+                value = value / 2;\n+            end\n+            if (counter_width < 1)\n+                counter_width = 1;\n+        end\n+    endfunction\n+\n+    localparam integer COUNT_WIDTH = counter_width(BAUD_DIV);\n+    localparam [31:0] DIV_LAST = BAUD_DIV - 1;\n+    reg [COUNT_WIDTH-1:0] baud_count;\n+    reg [3:0] bit_index;\n+    reg [8:0] shift_data;\n+\n+    always @(posedge clk) begin\n+        if (!rst_n) begin\n+            tx <= 1'b1;\n+            busy <= 1'b0;\n+            baud_count <= {COUNT_WIDTH{1'b0}};\n+            bit_index <= 4'd0;\n+            shift_data <= 9'h1ff;\n+        end else if (!busy) begin\n+            tx <= 1'b1;\n+            busy <= 1'b0;\n+            baud_count <= {COUNT_WIDTH{1'b0}};\n+            bit_index <= 4'd0;\n+            if (start) begin\n+                shift_data <= {1'b1, data_in};\n+                tx <= 1'b0;\n+                busy <= 1'b1;\n+            end\n+        end else if (baud_count == DIV_LAST[COUNT_WIDTH-1:0]) begin\n+            baud_count <= {COUNT_WIDTH{1'b0}};\n+            if (bit_index == 4'd9) begin\n+                busy <= 1'b0;\n+                tx <= 1'b1;\n+            end else begin\n+                bit_index <= bit_index + 1'b1;\n+                tx <= shift_data[0];\n+                shift_data <= {1'b1, shift_data[8:1]};\n+            end\n+        end else begin\n+            baud_count <= baud_count + 1'b1;\n+        end\n+    end\n+endmodule\n","content":"module uart_tx #(\n    parameter integer BAUD_DIV = 16\n) (\n    input wire clk,\n    input wire rst_n,\n    input wire [7:0] data_in,\n    input wire start,\n    output reg tx,\n    output reg busy\n);\n\n    function integer counter_width;\n        input integer divisor;\n        integer value;\n        begin\n            value = divisor - 1;\n            counter_width = 0;\n            while (value > 0) begin\n                counter_width = counter_width + 1;\n                value = value / 2;\n            end\n            if (counter_width < 1)\n                counter_width = 1;\n        end\n    endfunction\n\n    localparam integer COUNT_WIDTH = counter_width(BAUD_DIV);\n    localparam [31:0] DIV_LAST = BAUD_DIV - 1;\n    reg [COUNT_WIDTH-1:0] baud_count;\n    reg [3:0] bit_index;\n    reg [8:0] shift_data;\n\n    always @(posedge clk) begin\n        if (!rst_n) begin\n            tx <= 1'b1;\n            busy <= 1'b0;\n            baud_count <= {COUNT_WIDTH{1'b0}};\n            bit_index <= 4'd0;\n            shift_data <= 9'h1ff;\n        end else if (!busy) begin\n            tx <= 1'b1;\n            busy <= 1'b0;\n            baud_count <= {COUNT_WIDTH{1'b0}};\n            bit_index <= 4'd0;\n            if (start) begin\n                shift_data <= {1'b1, data_in};\n                tx <= 1'b0;\n                busy <= 1'b1;\n            end\n        end else if (baud_count == DIV_LAST[COUNT_WIDTH-1:0]) begin\n            baud_count <= {COUNT_WIDTH{1'b0}};\n            if (bit_index == 4'd9) begin\n                busy <= 1'b0;\n                tx <= 1'b1;\n            end else begin\n                bit_index <= bit_index + 1'b1;\n                tx <= shift_data[0];\n                shift_data <= {1'b1, shift_data[8:1]};\n            end\n        end else begin\n            baud_count <= baud_count + 1'b1;\n        end\n    end\nendmodule\n"}}

