@@ -0,0 +1,101 @@
+"""Synthetic host handoff only: source is parsed, never imported or executed.
+
+The two hand-written proposals are independent test data, not provider outputs.
+Their synthetic call IDs test binding and do not establish author independence.
+"""
+from copy import deepcopy
+import hashlib
+import json
+
+import pytest
+
+from app.agent.reference_bundle import BundleValidationError, validate_reference_bundle
+from app.agent.reference_context import ObservationDeclaration, build_reference_contexts
+from app.schemas import DesignSpec
+
+
+@pytest.mark.parametrize("synchronous", [False, True], ids=["combinational", "synchronous"])
+def test_context_contract_accepts_separate_host_stamped_model_and_literal_examples(synchronous):
+    ports = [
+        {"name": "a", "direction": "input", "width": 8, "description": "Input word"},
+        {"name": "q", "direction": "output", "width": 8, "description": "Output word"},
+    ]
+    behavior = ["The combinational output q equals a."]
+    original = "Copy a to q without clock or reset."
+    observation = ObservationDeclaration("combinational_all_known", None, None)
+    model_content = {"schema_version": 1, "source": (
+        "class Model:\n"
+        "    def evaluate(self, inputs):\n"
+        "        return {'q': inputs['a']}\n"
+    )}
+    example_content = {"schema_version": 1, "cases": [{"name": "limits", "steps": [
+        {"inputs": {"a": 0}, "expected": {"q": 0}},
+        {"inputs": {"a": 255}, "expected": {"q": 255}},
+    ]}]}
+    if synchronous:
+        ports += [
+            {"name": "clk", "direction": "input", "width": 1, "description": "Rising-edge clock"},
+            {"name": "rst_n", "direction": "input", "width": 1, "description": "Synchronous active-low reset"},
+        ]
+        original = "At each rising clk edge reset q to zero when rst_n is low; otherwise copy a to q."
+        behavior = [original]
+        observation = ObservationDeclaration("sync_active_low_all_known_after_rising_edge", "clk", "rst_n")
+        model_content = {"schema_version": 1, "source": (
+            "class Model:\n"
+            "    def __init__(self):\n"
+            "        self.reset()\n"
+            "    def reset(self):\n"
+            "        self.q = 0\n"
+            "    def step(self, inputs):\n"
+            "        if inputs['rst_n'] == 0:\n"
+            "            self.reset()\n"
+            "        else:\n"
+            "            self.q = inputs['a']\n"
+            "        return {'q': self.q}\n"
+        )}
+        example_content = {"schema_version": 1, "cases": [{"name": "reset_then_copy", "steps": [
+            {"inputs": {"a": 255, "rst_n": 0}, "expected": {"q": 0}},
+            {"inputs": {"a": 7, "rst_n": 1}, "expected": {"q": 7}},
+        ]}]}
+
+    spec = DesignSpec(top_module="neutral_word", summary=original, ports=ports,
+                      behavior=behavior, purely_combinational=not synchronous,
+                      test_plan=["Zero word", "Maximum word", "Changing word", "Repeated word"])
+    model_context, example_context = build_reference_contexts(original, spec, observation=observation)
+    model_data = json.loads(model_context.messages[1].content)
+    example_data = json.loads(example_context.messages[1].content)
+    assert model_data == example_data
+    contract = model_data["reference_contract"]
+    assert model_data["original_user_text"] == original
+    assert model_data["frozen_design_spec"] == spec.model_dump(mode="json")
+    assert model_context.tools == example_context.tools == ()
+    assert '"source"' in model_context.messages[0].content
+    assert '"cases"' in example_context.messages[0].content
+    assert "Every evaluate/step path must return" in model_context.messages[0].content
+    assert "65536 canonical UTF-8 JSON bytes" in example_context.messages[0].content
+    # Independent host canonicalization binds the exact context contract, including port order.
+    digest = hashlib.sha256(json.dumps(contract, ensure_ascii=False, sort_keys=True,
+                           separators=(",", ":"), allow_nan=False).encode("utf-8")).hexdigest()
+    model = {**model_content, "contract_sha256": digest, "author_call_id": "1" * 32}
+    examples = {**example_content, "contract_sha256": digest, "author_call_id": "2" * 32}
+    bundle = validate_reference_bundle(contract, model, examples)
+    assert bundle.contract_sha256 == digest
+    assert bundle.contract.profile == observation.profile
+    assert bundle.model.source == model_content["source"]
+    assert bundle.model.author_call_id != bundle.examples.author_call_id
+    assert len(bundle.examples.cases) == 1
+    assert dict(bundle.examples.cases[0].steps[-1].expected) == example_content["cases"][0]["steps"][-1]["expected"]
+    if synchronous:
+        assert "Model.step(self, inputs)" in model_context.messages[0].content
+        assert "begins with reset_port=0" in example_context.messages[0].content
+        assert all("clk" not in dict(step.inputs) for step in bundle.examples.cases[0].steps)
+    else:
+        assert "Model.evaluate(self, inputs)" in model_context.messages[0].content
+
+    # Content-only proposals cannot bypass the host provenance handoff.
+    with pytest.raises(BundleValidationError):
+        validate_reference_bundle(contract, model_content, example_content)
+    stale_model = deepcopy(model)
+    stale_model["contract_sha256"] = "0" * 64
+    with pytest.raises(BundleValidationError):
+        validate_reference_bundle(contract, stale_model, examples)
