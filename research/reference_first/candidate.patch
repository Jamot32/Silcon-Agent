+"""Controller seams for the host reference gate; no provider, Docker or simulator runs.
+
+The scripted proposals and receipts are unit data. The synthetic precheck does
+not execute the model, so these tests establish routing and gating only.
+"""
+import asyncio
+import hashlib
+import json
+from pathlib import Path
+from types import SimpleNamespace
+
+import pytest
+
+from app.agent.orchestrator import REFERENCE_MODULE, Orchestrator
+from app.agent.reference_bundle import validate_reference_bundle
+from app.agent.tools import ToolRunner
+from app.eda.reference_precheck import DRIVER_SHA256
+from app.llm.fake import FakeLLM
+from app.llm.types import Completion, LLMError, ToolCall
+from app.schemas import DesignSpec
+
+GOLDEN = Path(__file__).resolve().parents[2] / "designs/golden/counter"
+IMAGE = "sha256:" + "1" * 64
+INPUTS = ("rst_n", "enable", "up", "load", "load_value")
+MODEL = (
+    "class Model:\n"
+    "    def reset(self):\n"
+    "        self.count = 0\n"
+    "    def step(self, inputs):\n"
+    "        if inputs['rst_n'] == 0:\n"
+    "            self.count = 0\n"
+    "        elif inputs['load'] == 1:\n"
+    "            self.count = inputs['load_value']\n"
+    "        elif inputs['enable'] == 1:\n"
+    "            if inputs['up'] == 1:\n"
+    "                self.count = (self.count + 1) & 255\n"
+    "            else:\n"
+    "                self.count = (self.count - 1) & 255\n"
+    "        return {'count': self.count}\n"
+)
+
+
+def spec():
+    return DesignSpec.model_validate({
+        "top_module": "counter", "summary": "8-bit up/down counter with enable and load",
+        "ports": [{"name": name, "direction": "output" if name == "count" else "input",
+                   "width": 8 if name in {"count", "load_value"} else 1, "description": name}
+                  for name in ("clk", "rst_n", "enable", "up", "load", "load_value", "count")],
+        "behavior": ["Synchronous active-low reset clears count", "Load overrides enable",
+                     "Enabled up/down counting wraps modulo 256", "Disabled count holds"],
+        "test_plan": ["Synchronous reset", "Count and hold", "Load priority", "Wrap both ways"],
+    })
+
+
+def step(count, **pins):
+    return {"inputs": {name: pins.get(name, 1 if name == "rst_n" else 0) for name in INPUTS},
+            "expected": {"count": count}}
+
+
+def proposals():
+    reset = step(0, rst_n=0)
+    return [{"schema_version": 1, "source": MODEL},
+            {"schema_version": 1, "cases": [
+                {"name": "reset_hold", "steps": [reset, step(0)]},
+                {"name": "count_up", "steps": [reset, step(1, enable=1, up=1), step(2, enable=1, up=1)]},
+                {"name": "load_priority", "steps": [reset, step(200, load=1, load_value=200, enable=1, up=1)]},
+                {"name": "wrap_down", "steps": [reset, step(255, enable=1)]},
+            ]}]
+
+
+def completion(value):
+    content = value if isinstance(value, str) else json.dumps(value)
+    return Completion(content=content, model="unit-script", provider="fake", input_tokens=10,
+                      output_tokens=5, latency_ms=0, cost_usd=None)
+
+
+def tool_response(*calls):
+    return Completion(content="", tool_calls=list(calls), model="unit-script", provider="fake",
+                      input_tokens=10, output_tokens=5, latency_ms=0, cost_usd=None)
+
+
+def encoded(value):
+    return (json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False) + "\n").encode()
+
+
+class ReferenceEDA:
+    """Unit double: returns scripted results per module; never runs tools."""
+
+    def __init__(self, status="passed"):
+        self.status = status
+        self.sandbox = SimpleNamespace(completion_callback=None)
+        self.results = {}
+        self.modules = []
+
+    async def reference_precheck(self, contract, model, examples):
+        bundle = validate_reference_bundle(contract, model, examples)
+        cases = [{"name": c.name, "steps": [{"inputs": dict(s.inputs), "expected": dict(s.expected)}
+                                            for s in c.steps]} for c in bundle.examples.cases]
+        frozen = {"profile": bundle.contract.profile, "clock_port": bundle.contract.clock_port,
+                  "reset_port": bundle.contract.reset_port,
+                  "ports": [{"name": n, "direction": d, "width": w} for n, d, w in bundle.contract.ports]}
+        inputs = {"model.py": bundle.model.source_sha256,
+                  "contract.json": hashlib.sha256(encoded(frozen)).hexdigest(),
+                  "examples.json": hashlib.sha256(encoded(cases)).hexdigest(), "driver.py": DRIVER_SHA256}
+        steps = sum(len(c.steps) for c in bundle.examples.cases)
+        observation = {"version": 1, "status": "passed", "checked_steps": steps,
+                       "case_index": None, "step_index": None, "reason": None}
+        return {"schema_version": 1, "status": self.status, "image_id": IMAGE,
+                "contract_sha256": bundle.contract_sha256, "model_sha256": bundle.model.source_sha256,
+                "examples_sha256": bundle.examples.proposal_sha256, "driver_sha256": DRIVER_SHA256,
+                "cases_count": len(cases), "steps_count": steps,
+                "command": {"returncode": 0, "timed_out": False, "process_launched": True, "duration_seconds": 0.1},
+                "observation": observation, "observation_sha256": hashlib.sha256(encoded(observation)).hexdigest(),
+                "input_sha256_before": dict(inputs), "input_sha256_after": dict(inputs),
+                "receipt_path": ".eda/reference_precheck_" + "a" * 32 + "/output/receipt.json"}
+
+    async def lint(self, top):
+        return {"ok": True, "warnings": [], "errors": []}
+
+    async def run_tests(self, top, test_module):
+        self.modules.append(test_module)
+        return dict(self.results.get(test_module, {"ok": True, "passed": 4, "failed": 0, "failures": []}))
+
+
+class Planner:
+    def __init__(self, spec, eda):
+        self.spec, self.eda, self.image_identity = spec, eda, None
+
+    async def initialize(self):
+        self.image_identity = {"image_id": IMAGE, "source": "unit-only"}
+
+
+def build(tmp_path, *, status="passed", replies=None, script=()):
+    events = []
+
+    async def record(kind, payload):
+        events.append((kind, payload))
+
+    eda = ReferenceEDA(status)
+    tools = ToolRunner(tmp_path / "work", "unit-reference", eda=eda, event_callback=record,
+                       physical_planner_factory=Planner)
+    llm = FakeLLM([*(completion(value) for value in (proposals() if replies is None else replies)), *script])
+    orchestrator = Orchestrator(llm, tools, spec_text="An 8-bit up/down counter with load and enable.",
+                                event_callback=record)
+    orchestrator.design_spec = spec()
+
+    async def prepare():
+        await tools.configure_physics(orchestrator.design_spec)
+        await orchestrator._reference()
+        return orchestrator
+
+    return prepare, orchestrator, tools, eda, llm, events
+
+
+def reference_notes(events):
+    return [payload for kind, payload in events if kind == "note" and "reference" in payload]
+
+
+async def write_design(orchestrator):
+    for path in ("src/counter.v", "test/test_counter.py"):
+        result = await orchestrator.tools.execute(ToolCall(id=f"unit-{path}", name="write_file", arguments={
+            "path": path, "content": (GOLDEN / path).read_text()}))
+        assert result["ok"] is True, result
+
+
+def test_prepared_reference_installs_a_host_owned_module_before_rtl(tmp_path):
+    prepare, orchestrator, tools, eda, llm, events = build(tmp_path)
+    asyncio.run(prepare())
+    assert tools.reference_module == REFERENCE_MODULE
+    source = (tools.work_dir / f"test/{REFERENCE_MODULE}.py").read_text()
+    assert MODEL in source and source.count("@cocotb.test()") == 4
+    assert llm.budget.calls == 2 and not list((tools.work_dir / "src").glob("*.v"))
+    [note] = reference_notes(events)
+    assert note["reference"]["status"] == "prepared" and note["reference"]["cases"] == 4
+    assert note["reference"]["module_sha256"] == hashlib.sha256(source.encode()).hexdigest()
+    stages = [payload["stage"] for kind, payload in events if kind == "stage_changed"]
+    assert stages == ["REFERENCE"]
+    envelopes = [json.loads(path.read_text()) for path in (tools.work_dir / ".evidence/tools").glob("*/result.json")]
+    assert [envelope["tool"] for envelope in envelopes] == ["reference_precheck"]
+
+
+@pytest.mark.parametrize("status,replies,expected", [
+    ("model_disagreement", None, ("precheck", "not_passed")),
+    ("passed", ["not JSON", json.dumps(proposals()[1])], ("model", "invalid_json")),
+    ("passed", [proposals()[0], {"schema_version": 1, "unresolved": "count is open while loading."}],
+     ("examples", "author_abstained")),
+])
+def test_preparation_failure_falls_back_explicitly_to_the_ordinary_route(tmp_path, status, replies, expected):
+    prepare, orchestrator, tools, eda, llm, events = build(tmp_path, status=status, replies=replies)
+    asyncio.run(prepare())
+    assert tools.reference_module is None
+    assert not (tools.work_dir / f"test/{REFERENCE_MODULE}.py").exists()
+    [note] = reference_notes(events)
+    assert note["reference"]["status"] == "unavailable"
+    assert (note["reference"]["phase"], note["reference"]["code"]) == expected
+    assert "no reference-model gate" in note["text"]
+
+
+def test_verify_requires_both_the_model_module_and_the_host_reference(tmp_path):
+    script = [tool_response(ToolCall(id="verify-run", name="run_tests",
+                                     arguments={"top": "counter", "test_module": "test_counter"}))]
+    prepare, orchestrator, tools, eda, llm, events = build(tmp_path, script=script)
+
+    async def scenario():
+        await prepare()
+        await write_design(orchestrator)
+        with pytest.raises(ValueError, match="must pass"):
+            tools._require_verified("counter")
+        assert await orchestrator._verify() is True
+
+    asyncio.run(scenario())
+    assert eda.modules == ["test_counter", REFERENCE_MODULE]
+    assert orchestrator.test_module == "test_counter"
+    assert tools.verified_revision == tools.rtl_digest()
+    tools._require_verified("counter")
+
+
+def test_reference_dut_mismatch_enters_ordinary_rtl_repair(tmp_path):
+    script = [tool_response(ToolCall(id="verify-run", name="run_tests",
+                                     arguments={"top": "counter", "test_module": "test_counter"}))]
+    prepare, orchestrator, tools, eda, llm, events = build(tmp_path, script=script)
+    eda.results[REFERENCE_MODULE] = {"ok": False, "passed": 3, "failed": 1, "failures": [
+        {"test": "test_reference_01_count_up", "message": "DUT_REFERENCE_MISMATCH:count expected 1 got 2"}]}
+
+    async def scenario():
+        await prepare()
+        await write_design(orchestrator)
+        return await orchestrator._verify()
+
+    assert asyncio.run(scenario()) is False
+    assert orchestrator._hypothesis_required is True
+    assert orchestrator._last_test_result["failed"] == 1
+    assert tools.verified_revision is None
+
+
+def test_reference_self_check_failure_in_simulation_is_not_an_rtl_verdict(tmp_path):
+    script = [tool_response(ToolCall(id="verify-run", name="run_tests",
+                                     arguments={"top": "counter", "test_module": "test_counter"}))]
+    prepare, orchestrator, tools, eda, llm, events = build(tmp_path, script=script)
+    eda.results[REFERENCE_MODULE] = {"ok": False, "passed": 3, "failed": 1, "failures": [
+        {"test": "test_reference_00_reset_hold", "message": "REFERENCE_LITERAL_MISMATCH expected {} got {}"}]}
+
+    async def scenario():
+        await prepare()
+        await write_design(orchestrator)
+        await orchestrator._verify()
+
+    with pytest.raises(LLMError, match="reference setup failure"):
+        asyncio.run(scenario())
+
+
+def test_model_cannot_write_or_run_the_host_reference_module(tmp_path):
+    prepare, orchestrator, tools, eda, llm, events = build(tmp_path)
+    path = f"test/{REFERENCE_MODULE}.py"
+
+    async def scenario():
+        await prepare()
+        before = (tools.work_dir / path).read_bytes()
+        written = await orchestrator._execute("VERIFY", ToolCall(id="w", name="write_file", arguments={
+            "path": path, "content": "import cocotb\n"}))
+        ran = await orchestrator._execute("VERIFY", ToolCall(id="r", name="run_tests", arguments={
+            "top": "counter", "test_module": REFERENCE_MODULE}))
+        direct = await tools.execute(ToolCall(id="d", name="write_file", arguments={
+            "path": path, "content": "import cocotb\n"}))
+        return before, written, ran, direct
+
+    before, written, ran, direct = asyncio.run(scenario())
+    assert written["ok"] is False and "host-owned" in written["error"]
+    assert ran["ok"] is False and orchestrator.test_module is None and eda.modules == []
+    assert direct["ok"] is False and "host-owned" in direct["error"]
+    assert (tools.work_dir / path).read_bytes() == before
+
+
+def test_reference_context_note_reaches_rtl_and_verify_only(tmp_path):
+    prepare, orchestrator, tools, eda, llm, events = build(tmp_path)
+    asyncio.run(prepare())
+    notes = {stage: [m.content for m in orchestrator._context(stage) if m.content.startswith("Host note:")]
+             for stage in ("RTL", "VERIFY", "OPTIMIZE")}
+    assert len(notes["RTL"]) == len(notes["VERIFY"]) == 1 and notes["OPTIMIZE"] == []
+    assert f"test/{REFERENCE_MODULE}.py" in notes["RTL"][0]
