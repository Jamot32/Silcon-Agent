index 0000000..33312e8
--- /dev/null
+++ b/backend/app/agent/reference_cocotb.py
@@ -0,0 +1,125 @@
+"""Unintegrated ordinary cocotb composition; generated model code is data here.
+
+The caller supplies the exact original contract because ReferenceBundle stores
+normalized ports, while its digest also binds the original JSON port order.
+Admission is neither semantic correctness nor independent-author evidence.
+"""
+from dataclasses import asdict
+import json
+
+from app.agent.reference_bundle import (
+    DirectedCase, DirectedStep, ExampleMaterial, ModelMaterial, ReferenceBundle,
+    ReferenceContract, validate_reference_bundle,
+)
+from app.agent.tools import MAX_WRITE_BYTES, _validate_test
+
+
+class ReferenceCompositionError(ValueError):
+    """A fixed composition code, not an RTL failure classification."""
+
+
+def _canonical(value) -> str:
+    return json.dumps(value, sort_keys=True, separators=(",", ":"),
+                      ensure_ascii=False, allow_nan=False)
+
+
+def _revalidate(bundle: ReferenceBundle, original_contract: dict) -> ReferenceBundle:
+    try:
+        if (type(bundle) is not ReferenceBundle or type(bundle.contract) is not ReferenceContract
+                or type(bundle.model) is not ModelMaterial or type(bundle.examples) is not ExampleMaterial
+                or type(bundle.contract.ports) is not tuple or type(bundle.examples.cases) is not tuple
+                or any(type(p) is not tuple or len(p) != 3 for p in bundle.contract.ports)):
+            raise ValueError
+        cases = []
+        for case in bundle.examples.cases:
+            if type(case) is not DirectedCase or type(case.steps) is not tuple:
+                raise ValueError
+            steps = []
+            for step in case.steps:
+                if (type(step) is not DirectedStep or
+                        any(type(pins) is not tuple or
+                            any(type(pair) is not tuple or len(pair) != 2 for pair in pins)
+                            for pins in (step.inputs, step.expected))):
+                    raise ValueError
+                inputs, expected = dict(step.inputs), dict(step.expected)
+                if len(inputs) != len(step.inputs) or len(expected) != len(step.expected):
+                    raise ValueError
+                steps.append({"inputs": inputs, "expected": expected})
+            cases.append({"name": case.name, "steps": steps})
+        model = {"schema_version": 1, "contract_sha256": bundle.contract_sha256,
+                 "author_call_id": bundle.model.author_call_id, "source": bundle.model.source}
+        examples = {"schema_version": 1, "contract_sha256": bundle.contract_sha256,
+                    "author_call_id": bundle.examples.author_call_id, "cases": cases}
+        checked = validate_reference_bundle(original_contract, model, examples)
+        # JSON equality also distinguishes bool from int; dataclass equality alone does not.
+        if _canonical(asdict(checked)) != _canonical(asdict(bundle)):
+            raise ValueError
+        return checked
+    except (AttributeError, KeyError, TypeError, ValueError, OverflowError, RecursionError):
+        raise ReferenceCompositionError("bundle_or_contract") from None
+
+
+def compose_reference_cocotb(bundle: ReferenceBundle, original_contract: dict) -> str:
+    """Revalidate and compose explicit test cases without executing model source.
+
+    All listed samples compare all outputs. Reference/literal disagreement gets a
+    distinct assertion prefix, but ordinary ToolRunner does not yet classify that
+    as a separate host failure; future orchestration must not repair RTL for it.
+    """
+    bundle = _revalidate(bundle, original_contract)
+    cases = bundle.examples.cases
+    sequences = {tuple((step.inputs, step.expected) for step in case.steps) for case in cases}
+    if len(cases) < 4 or len(sequences) != len(cases):
+        raise ReferenceCompositionError("cases_require_four_distinct_sequences")
+    sync = bundle.contract.profile == "sync_active_low_all_known_after_rising_edge"
+    inputs = [name for name, direction, _ in bundle.contract.ports
+              if direction == "input" and name != bundle.contract.clock_port]
+    outputs = [(name, width) for name, direction, width in bundle.contract.ports if direction == "output"]
+    lines = [
+        "# Host-composed research test; no claim of semantic correctness or author independence.",
+        f"# contract_sha256={bundle.contract_sha256}",
+        f"# model_source_sha256={bundle.model.source_sha256}",
+        f"# example_proposal_sha256={bundle.examples.proposal_sha256}",
+        "import cocotb", "from cocotb.triggers import ReadOnly, Timer", "",
+    ]
+    # Embed exact bytes once: no exec, import, compile or model construction on the host.
+    prefix = "\n".join(lines) + "\n" + bundle.model.source + "\n\n"
+    lines = ["async def _reference_case(dut, steps):", "    model = Model()"]
+    if sync:
+        lines.append("    model.reset()")
+    lines.append("    for inputs, expected in steps:")
+    if sync:
+        lines.append(f"        dut._id({bundle.contract.clock_port!r}, extended=False).value = 0")
+    for name in inputs:
+        lines.append(f"        dut._id({name!r}, extended=False).value = inputs[{name!r}]")
+    lines.append("        await Timer(1, unit='ns')")
+    if sync:
+        lines += [f"        dut._id({bundle.contract.clock_port!r}, extended=False).value = 1",
+                  "        await Timer(1, unit='ns')"]
+    lines += ["        await ReadOnly()",
+              f"        predicted = model.{'step' if sync else 'evaluate'}(inputs)",
+              f"        assert type(predicted) is dict and set(predicted) == set({tuple(n for n, _ in outputs)!r}), 'REFERENCE_MODEL_INVALID:outputs'"]
+    for name, width in outputs:
+        lines.append(f"        assert type(predicted[{name!r}]) is int and 0 <= predicted[{name!r}] < (1 << {width}), 'REFERENCE_MODEL_INVALID:value'")
+    lines.append("        assert predicted == expected, 'REFERENCE_LITERAL_MISMATCH expected %r got %r' % (expected, predicted)")
+    for name, _ in outputs:
+        lines += [f"        value = dut._id({name!r}, extended=False).value",
+                  f"        assert value.is_resolvable, 'DUT_OUTPUT_UNRESOLVED:{name}'",
+                  f"        assert int(value) == predicted[{name!r}], 'DUT_REFERENCE_MISMATCH:{name} expected %r got %r' % (predicted[{name!r}], int(value))"]
+    # Exit ReadOnly before any subsequent signal assignment, including the next case step.
+    lines.append("        await Timer(1, unit='ns')")
+    if sync:
+        lines += [f"        dut._id({bundle.contract.clock_port!r}, extended=False).value = 0",
+                  "        await Timer(1, unit='ns')"]
+    for index, case in enumerate(cases):
+        steps = tuple((dict(step.inputs), dict(step.expected)) for step in case.steps)
+        lines += ["", "@cocotb.test()", f"async def test_reference_{index:02d}_{case.name}(dut):",
+                  f"    await _reference_case(dut, {steps!r})"]
+    source = prefix + "\n".join(lines) + "\n"
+    if len(source.encode("utf-8")) > MAX_WRITE_BYTES:
+        raise ReferenceCompositionError("module_size")
+    try:
+        _validate_test(source)
+    except ValueError:
+        raise ReferenceCompositionError("test_source_policy") from None
+    return source
