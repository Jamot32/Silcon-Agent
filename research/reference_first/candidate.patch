@@ -0,0 +1,186 @@
+"""Host-side admission and observation seams; synthetic data is never EDA evidence."""
+import json
+import pytest
+from app.eda.reference_precheck import interpret_observation
+
+
+def payload(**changes):
+    obj = {'version': 1, 'status': 'passed', 'checked_steps': 3,
+           'case_index': None, 'step_index': None, 'reason': None}
+    obj.update(changes)
+    return json.dumps(obj).encode()
+
+
+def test_host_process_and_observation_are_reconciled():
+    assert interpret_observation(0, False, payload(), [2, 1])['status'] == 'passed'
+    assert interpret_observation(1, False, payload(), [2, 1])['status'] == 'process_error'
+    assert interpret_observation(0, True, payload(), [2, 1])['status'] == 'timeout'
+    mismatch = payload(status='model_disagreement', checked_steps=1, case_index=0,
+                       step_index=1, reason='literal_mismatch')
+    assert interpret_observation(0, False, mismatch, [2, 1])['status'] == 'model_disagreement'
+
+
+@pytest.mark.parametrize('data', [None, b'{', b' ' * 65537,
+    b'{"version":1,"status":"passed","status":"passed","checked_steps":3,"case_index":null,"step_index":null,"reason":null}',
+    payload(checked_steps=True), payload(checked_steps=2), payload(extra='unknown'),
+    payload(status='model_disagreement', checked_steps=0, case_index=0, step_index=1, reason='literal_mismatch')])
+def test_malformed_observation_cannot_claim_a_pass(data):
+    assert interpret_observation(0, False, data, [2, 1])['status'] == 'invalid_observation'
+
+
+@pytest.mark.parametrize('status,reason,index', [
+    ('setup_error', 'setup_exception', None), ('invalid_output', 'output_shape', 0),
+    ('model_error', 'model_exception', 0)])
+def test_setup_invalid_output_and_model_errors_remain_distinct(status, reason, index):
+    data = payload(status=status, checked_steps=0, case_index=index, step_index=index, reason=reason)
+    assert interpret_observation(0, False, data, [2, 1])['status'] == status
+
+
+
+def _materials():
+    from app.agent.reference_bundle import contract_digest
+    contract = {'schema_version': 1, 'profile': 'combinational_all_known', 'clock_port': None,
+                'reset_port': None, 'ports': [{'name': 'a', 'direction': 'input', 'width': 2},
+                                              {'name': 'y', 'direction': 'output', 'width': 2}]}
+    digest = contract_digest(contract)
+    model = {'schema_version': 1, 'contract_sha256': digest, 'author_call_id': 'a'*32,
+             'source': 'class Model:\n    def evaluate(self, inputs):\n        return {"y": inputs["a"]}\n'}
+    examples = {'schema_version': 1, 'contract_sha256': digest, 'author_call_id': 'b'*32,
+                'cases': [{'name': 'literal', 'steps': [{'inputs': {'a': 3}, 'expected': {'y': 3}}]}]}
+    return contract, model, examples
+
+
+def test_async_precheck_records_sandbox_boundary_without_executing_model_on_host(tmp_path, monkeypatch):
+    import asyncio
+    from app.eda.reference_precheck import run_precheck
+    from app.eda.sandbox import CommandObservation, CommandResult, DockerSandbox
+    image = 'sha256:' + 'a'*64
+    callbacks = []
+    async def synthetic_run(self, command, *, input_dir, output_dir, **kwargs):
+        assert self.image == image and command == ['python3', '-I', '-B', '/input/driver.py']
+        assert (input_dir/'model.py').read_text() == _materials()[1]['source']
+        assert (input_dir/'examples.json').is_file() and (input_dir/'driver.py').is_file()
+        (output_dir/'observation.json').write_bytes(payload(checked_steps=1))
+        log = output_dir/'tool.log'; log.write_text('synthetic')
+        result = CommandResult(0, False, log, 'synthetic')
+        self.completion_callback(CommandObservation(tuple(command), input_dir, output_dir, result, 0.5, True))
+        return result
+    monkeypatch.setattr(DockerSandbox, 'run', synthetic_run)
+    sandbox = DockerSandbox(image=image, completion_callback=callbacks.append)
+    outcome = asyncio.run(run_precheck(*_materials(), work_dir=tmp_path, sandbox=sandbox))
+    assert outcome['status'] == 'passed'
+    assert outcome['command'] == {'returncode': 0, 'timed_out': False, 'process_launched': True, 'duration_seconds': 0.5}
+    assert len(callbacks) == 1
+    assert outcome['input_sha256_before'] == outcome['input_sha256_after']
+    assert json.loads((tmp_path/outcome['receipt_path']).read_text()) == outcome
+
+
+def test_async_precheck_refuses_unpinned_image(tmp_path):
+    import asyncio
+    from app.eda.reference_precheck import run_precheck
+    from app.eda.sandbox import DockerSandbox
+    with pytest.raises(ValueError, match='image'):
+        asyncio.run(run_precheck(*_materials(), work_dir=tmp_path, sandbox=DockerSandbox(image='mutable-tag')))
+
+
+def test_async_precheck_cancellation_retains_actual_command_and_original_exception(tmp_path, monkeypatch):
+    import asyncio
+    from app.eda.reference_precheck import run_precheck
+    from app.eda.sandbox import CommandObservation, CommandResult, DockerSandbox
+    async def cancelled(self, command, *, input_dir, output_dir, **kwargs):
+        log = output_dir/'tool.log'; log.write_text('cancelled')
+        result = CommandResult(-9, True, log, '')
+        self.completion_callback(CommandObservation(tuple(command), input_dir, output_dir, result, 0.2, True))
+        raise asyncio.CancelledError('original cancellation')
+    monkeypatch.setattr(DockerSandbox, 'run', cancelled)
+    with pytest.raises(asyncio.CancelledError, match='original cancellation'):
+        asyncio.run(run_precheck(*_materials(), work_dir=tmp_path, sandbox=DockerSandbox(image='sha256:'+'a'*64)))
+    receipts = list(tmp_path.glob('.eda/reference_precheck_*/output/receipt.json'))
+    assert len(receipts) == 1
+    receipt = json.loads(receipts[0].read_text())
+    assert receipt['status'] == 'cancelled' and receipt['command']['returncode'] == -9
+    assert receipt['command']['timed_out'] is True and receipt['observation'] is None
+
+
+def test_async_precheck_does_not_trust_mismatched_command_observation(tmp_path, monkeypatch):
+    import asyncio
+    from app.eda.reference_precheck import run_precheck
+    from app.eda.sandbox import CommandObservation, CommandResult, DockerSandbox
+    async def mismatch(self, command, *, input_dir, output_dir, **kwargs):
+        (output_dir/'observation.json').write_bytes(payload(checked_steps=1))
+        log = output_dir/'tool.log'; log.write_text('synthetic')
+        self.completion_callback(CommandObservation(tuple(command), input_dir, output_dir,
+                                  CommandResult(1, False, log, ''), 0.1, True))
+        return CommandResult(0, False, log, '')
+    monkeypatch.setattr(DockerSandbox, 'run', mismatch)
+    result = asyncio.run(run_precheck(*_materials(), work_dir=tmp_path, sandbox=DockerSandbox(image='sha256:'+'a'*64)))
+    assert result['status'] == 'observation_error' and result['command'] is None
+
+
+def test_async_precheck_detects_changed_snapshot(tmp_path, monkeypatch):
+    import asyncio
+    from app.eda.reference_precheck import run_precheck
+    from app.eda.sandbox import CommandObservation, CommandResult, DockerSandbox
+    async def changed(self, command, *, input_dir, output_dir, **kwargs):
+        (input_dir/'model.py').write_text('changed')
+        (output_dir/'observation.json').write_bytes(payload(checked_steps=1))
+        log = output_dir/'tool.log'; log.write_text('synthetic')
+        result = CommandResult(0, False, log, '')
+        self.completion_callback(CommandObservation(tuple(command), input_dir, output_dir, result, 0.1, True))
+        return result
+    monkeypatch.setattr(DockerSandbox, 'run', changed)
+    result = asyncio.run(run_precheck(*_materials(), work_dir=tmp_path, sandbox=DockerSandbox(image='sha256:'+'a'*64)))
+    assert result['status'] == 'input_changed' and result['input_sha256_before'] != result['input_sha256_after']
+
+
+def test_async_precheck_refuses_symlinked_eda_directory(tmp_path):
+    import asyncio
+    from app.eda.reference_precheck import run_precheck
+    from app.eda.sandbox import DockerSandbox
+    destination = tmp_path/'other'; destination.mkdir(); (tmp_path/'.eda').symlink_to(destination, target_is_directory=True)
+    with pytest.raises(OSError):
+        asyncio.run(run_precheck(*_materials(), work_dir=tmp_path, sandbox=DockerSandbox(image='sha256:'+'a'*64)))
+
+
+def test_async_precheck_does_not_hide_unconfirmed_container_cleanup(tmp_path, monkeypatch):
+    import asyncio
+    from app.eda.reference_precheck import run_precheck
+    from app.eda.sandbox import CommandObservation, CommandResult, DockerSandbox
+    async def failed_cleanup(self, command, *, input_dir, output_dir, **kwargs):
+        (output_dir/'observation.json').write_bytes(payload(checked_steps=1))
+        log = output_dir/'tool.log'; log.write_text('cleanup unconfirmed')
+        result = CommandResult(-9, True, log, 'cleanup unconfirmed', cleanup_unconfirmed=True)
+        self.completion_callback(CommandObservation(tuple(command), input_dir, output_dir, result, 0.1, True))
+        return result
+    monkeypatch.setattr(DockerSandbox, 'run', failed_cleanup)
+    result = asyncio.run(run_precheck(*_materials(), work_dir=tmp_path, sandbox=DockerSandbox(image='sha256:'+'a'*64)))
+    assert result['status'] == 'cleanup_error' and result['observation'] is None
+    assert result['command']['returncode'] == -9 and result['command']['timed_out'] is True
+
+
+def test_precheck_pins_image_and_observer_before_await(tmp_path, monkeypatch):
+    import asyncio
+    from app.eda.reference_precheck import run_precheck
+    from app.eda.sandbox import CommandObservation, CommandResult, DockerSandbox
+    async def scenario():
+        started = asyncio.Event(); finish = asyncio.Event(); first = []; later = []
+        image = 'sha256:'+'a'*64
+        sandbox = DockerSandbox(image=image, completion_callback=first.append)
+        async def synthetic_run(self, command, *, input_dir, output_dir, **kwargs):
+            assert self.image == image
+            started.set(); await finish.wait()
+            (output_dir/'observation.json').write_bytes(payload(checked_steps=1))
+            log = output_dir/'tool.log'; log.write_text('synthetic')
+            result = CommandResult(0, False, log, 'synthetic')
+            self.completion_callback(CommandObservation(tuple(command), input_dir, output_dir, result, 0.5, True))
+            return result
+        monkeypatch.setattr(DockerSandbox, 'run', synthetic_run)
+        task = asyncio.create_task(run_precheck(*_materials(), work_dir=tmp_path, sandbox=sandbox))
+        await started.wait()
+        sandbox.image = 'sha256:'+'b'*64
+        sandbox.completion_callback = later.append
+        finish.set(); receipt = await task
+        assert receipt['image_id'] == image
+        assert len(first) == 1 and not later
+        assert receipt['status'] == 'passed'
+    asyncio.run(scenario())
