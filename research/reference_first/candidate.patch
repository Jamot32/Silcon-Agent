+"""Synthetic behavior seam only; no provider, container or generated execution."""
+import asyncio
+from copy import deepcopy
+import hashlib
+import json
+
+import pytest
+
+from app.agent.reference_bundle import validate_reference_bundle
+from app.agent.reference_workflow import HostAuthorResult, ReferenceWorkflowError, prepare_reference
+from app.llm.fake import FakeLLM
+from app.llm.types import Budget, Completion
+from app.schemas import DesignSpec
+from app.agent.reference_context import ObservationDeclaration
+
+IMAGE = "sha256:" + "9" * 64
+DRIVER = "d" * 64
+SOURCE = "class Model:\n    def evaluate(self, inputs):\n        return {'q': inputs['a']}\n"
+
+
+def encoded(value):
+    return (json.dumps(value, sort_keys=True, separators=(",", ":"), allow_nan=False) + "\n").encode()
+
+
+def sha(raw): return hashlib.sha256(raw).hexdigest()
+
+
+def spec():
+    return DesignSpec(top_module="neutral_word", summary="Copy a to q.", purely_combinational=True,
+                      ports=[{"name":"a","direction":"input","width":8,"description":"Input word"},
+                             {"name":"q","direction":"output","width":8,"description":"Output word"}],
+                      behavior=["The output q equals a."],
+                      test_plan=["Zero", "One", "High bit", "Maximum"])
+
+
+def responses():
+    return [{"schema_version":1,"source":SOURCE},
+            {"schema_version":1,"cases":[{"name":f"word_{value}","steps":[
+                {"inputs":{"a":value},"expected":{"q":value}}]} for value in [0,1,128,255]]}]
+
+
+def completion(value):
+    return Completion(content=json.dumps(value), model="scripted", input_tokens=10, output_tokens=5,
+                      latency_ms=1, cost_usd=None, provider="fake")
+
+
+class Authors:
+    def __init__(self, replies=None, *, budget=None):
+        self.llm = FakeLLM([completion(v) for v in (responses() if replies is None else replies)], budget=budget)
+        self.events = []
+        self.ids = ["1" * 32, "2" * 32]
+
+    async def __call__(self, messages, tools):
+        self.events.append("author")
+        answer = await self.llm.complete(messages, tools)
+        return HostAuthorResult(self.ids[len(self.events)-1], answer)
+
+
+async def successful_precheck(contract, model, examples):
+    bundle = validate_reference_bundle(contract, model, examples)
+    frozen = {"profile":bundle.contract.profile,"clock_port":bundle.contract.clock_port,
+              "reset_port":bundle.contract.reset_port,"ports":[
+                  {"name":n,"direction":d,"width":w} for n,d,w in bundle.contract.ports]}
+    cases = [{"name":c.name,"steps":[{"inputs":dict(s.inputs),"expected":dict(s.expected)}
+                                    for s in c.steps]} for c in bundle.examples.cases]
+    inputs = {"model.py":bundle.model.source_sha256,"contract.json":sha(encoded(frozen)),
+              "examples.json":sha(encoded(cases)),"driver.py":DRIVER}
+    steps = sum(len(c.steps) for c in bundle.examples.cases)
+    observation = {"version":1,"status":"passed","checked_steps":steps,
+                   "case_index":None,"step_index":None,"reason":None}
+    return {"schema_version":1,"status":"passed","image_id":IMAGE,
+            "contract_sha256":bundle.contract_sha256,"model_sha256":bundle.model.source_sha256,
+            "examples_sha256":bundle.examples.proposal_sha256,"driver_sha256":DRIVER,
+            "cases_count":len(cases),"steps_count":steps,
+            "command":{"returncode":0,"timed_out":False,"process_launched":True,"duration_seconds":0.1},
+            "observation":observation,"observation_sha256":sha(encoded(observation)),
+            "input_sha256_before":deepcopy(inputs),"input_sha256_after":deepcopy(inputs),
+            "receipt_path":".eda/reference_precheck_" + "a" * 32 + "/output/receipt.json"}
+
+
+async def prepare(authors, *, precheck=successful_precheck, design=None, observation=None):
+    return await prepare_reference("Copy input a to q.", spec() if design is None else design,
+        observation=ObservationDeclaration("combinational_all_known",None,None) if observation is None else observation,
+        author_call=authors, budget=authors.llm.budget, precheck=precheck,
+        image_id=IMAGE, driver_sha256=DRIVER)
+
+
+def test_two_sequential_spec_only_authors_then_precheck_then_host_composer():
+    authors = Authors(); events = authors.events
+    async def precheck(*args):
+        events.append("precheck")
+        return await successful_precheck(*args)
+    prepared = asyncio.run(prepare(authors, precheck=precheck))
+    assert events == ["author","author","precheck"]
+    assert [call.call_id for call in prepared.calls] == ["1"*32,"2"*32]
+    assert prepared.test_source.count("@cocotb.test()") == 4
+    assert SOURCE in prepared.test_source
+    assert prepared.assurance == "spec_derived_implementation_blind"
+    assert authors.llm.budget.calls == 2 and authors.llm.budget.cost_usd is None
+    first, second = authors.llm.requests
+    assert first[1] == second[1] == []
+    assert [m.role for m in first[0]] == ["system","user"]
+    assert [m.role for m in second[0]] == ["system","user"]
+    assert json.loads(first[0][1].content) == json.loads(second[0][1].content)
+    assert SOURCE not in second[0][1].content
+
+
+@pytest.mark.parametrize("text", ["not JSON", '```json\n{}\n```',
+    '{"schema_version":1,"schema_version":1,"source":"x"}',
+    '{"schema_version":true,"source":"x"}', '{"schema_version":1,"source":NaN}',
+    '{"schema_version":1,"source":"x","author_call_id":"injected"}',
+    '{"schema_version":1,"source":"import os"}', '[]', ' ' * (262144+1)])
+def test_bad_first_author_output_stops_without_examples_or_precheck(text):
+    authors = Authors(); authors.llm.responses[0].content = text
+    async def forbidden(*args): pytest.fail("precheck must not run")
+    with pytest.raises(ReferenceWorkflowError) as error:
+        asyncio.run(prepare(authors, precheck=forbidden))
+    assert error.value.rtl_repair_allowed is False
+    assert authors.llm.budget.calls == 1
+
+
+@pytest.mark.parametrize("index,artifact,calls", [(0, "model", 1), (1, "examples", 2)])
+def test_declared_abstention_is_a_distinct_outcome_without_precheck(index, artifact, calls):
+    replies = responses(); replies[index] = {"schema_version": 1, "unresolved": "out is unspecified while idle."}
+    authors = Authors(replies)
+    async def forbidden(*args): pytest.fail("an abstention must not reach the precheck")
+    with pytest.raises(ReferenceWorkflowError) as error:
+        asyncio.run(prepare(authors, precheck=forbidden))
+    assert (error.value.phase, error.value.code) == (artifact, "author_abstained")
+    assert "unspecified" not in str(error.value)
+    assert authors.llm.budget.calls == calls
+
+
+def test_model_tool_call_is_rejected_even_with_valid_content():
+    from app.llm.types import ToolCall
+    authors = Authors(); authors.llm.responses[0].tool_calls = [ToolCall(id="call", name="write_file", arguments={})]
+    with pytest.raises(ReferenceWorkflowError): asyncio.run(prepare(authors))
+    assert authors.llm.budget.calls == 1
+
+
+@pytest.mark.parametrize("bad_id", ["not-a-host-id", "1" * 32])
