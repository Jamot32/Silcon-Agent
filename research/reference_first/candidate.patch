+++ b/backend/tests/test_reference_cocotb.py
@@ -0,0 +1,143 @@
+"""Neutral composition controls; emitted model/test source is never executed here."""
+import ast
+from copy import deepcopy
+from dataclasses import replace
+
+import pytest
+
+from app.agent.reference_bundle import contract_digest, validate_reference_bundle
+from app.agent.reference_cocotb import compose_reference_cocotb
+from app.agent.tools import _validate_test
+
+
+def materials():
+    # Deliberately unsorted: the exact original port order participates in the digest.
+    contract = {"schema_version": 1, "profile": "combinational_all_known",
+                "clock_port": None, "reset_port": None, "ports": [
+                    {"name": "q", "direction": "output", "width": 8},
+                    {"name": "a", "direction": "input", "width": 8},
+                ]}
+    digest = contract_digest(contract)
+    model = {"schema_version": 1, "contract_sha256": digest, "author_call_id": "1" * 32,
+             "source": "class Model:\n    def evaluate(self, inputs):\n        return {'q': inputs['a']}\n"}
+    examples = {"schema_version": 1, "contract_sha256": digest, "author_call_id": "2" * 32,
+                "cases": [{"name": f"word_{n}", "steps": [
+                    {"inputs": {"a": n}, "expected": {"q": n}},
+                ]} for n in (0, 1, 128, 255)]}
+    return contract, model, examples
+
+
+def emit(contract, model, examples):
+    return compose_reference_cocotb(validate_reference_bundle(contract, model, examples), contract)
+
+
+def test_emits_exact_source_and_four_explicit_unskipped_cocotb_cases_deterministically():
+    contract, model, examples = materials()
+    before = deepcopy((contract, model, examples))
+    bundle = validate_reference_bundle(contract, model, examples)
+    source = compose_reference_cocotb(bundle, contract)
+    assert compose_reference_cocotb(bundle, contract) == source
+    assert (contract, model, examples) == before
+    assert source.count(model["source"]) == 1
+    for digest in (bundle.contract_sha256, bundle.model.source_sha256, bundle.examples.proposal_sha256):
+        assert digest in source
+    tests = [node for node in ast.parse(source).body if isinstance(node, ast.AsyncFunctionDef)
+             and node.decorator_list]
+    assert [node.name for node in tests] == [f"test_reference_{i:02d}_word_{n}" for i, n in enumerate((0, 1, 128, 255))]
+    for node in tests:
+        assert len(node.decorator_list) == 1
+        call = node.decorator_list[0]
+        assert isinstance(call, ast.Call) and ast.unparse(call.func) == "cocotb.test"
+        assert not call.args and not call.keywords  # No skip/expect-fail or preset padding.
+        assert isinstance(node.body[0], ast.Expr) and isinstance(node.body[0].value, ast.Await)
+    _validate_test(source)
+    assert len(source.encode("utf-8")) <= 128 * 1024
+    assert "REFERENCE_LITERAL_MISMATCH" in source and "DUT_REFERENCE_MISMATCH" in source
+    assert "is_resolvable" in source and "await ReadOnly()" in source
+
+
+@pytest.mark.parametrize("case_count", [1, 3])
+def test_rejects_fewer_than_four_actual_case_entries(case_count):
+    contract, model, examples = materials()
+    examples["cases"] = examples["cases"][:case_count]
+    with pytest.raises(ValueError, match="cases"):
+        emit(contract, model, examples)
+
+
+def test_rejects_four_names_padding_the_same_literal_case():
+    contract, model, examples = materials()
+    for case in examples["cases"]:
+        case["steps"] = deepcopy(examples["cases"][0]["steps"])
+    with pytest.raises(ValueError, match="cases"):
+        emit(contract, model, examples)
+
+
+@pytest.mark.parametrize("change", ["reordered", "missing", "wrong_role"])
+def test_exact_original_contract_is_required_not_only_its_normalized_ports(change):
+    contract, model, examples = materials()
+    bundle = validate_reference_bundle(contract, model, examples)
+    wrong = deepcopy(contract)
+    if change == "reordered": wrong["ports"].reverse()
+    elif change == "missing": wrong.pop("clock_port")
+    else: wrong["reset_port"] = "a"
+    with pytest.raises(ValueError, match="bundle|contract"):
+        compose_reference_cocotb(bundle, wrong)
+
+
+@pytest.mark.parametrize("change", ["source", "source_hash", "examples_hash", "duplicate_pin", "mutable_cases"])
+def test_forged_bundle_dataclasses_are_revalidated_before_source_can_be_emitted(change):
+    contract, model, examples = materials()
+    bundle = validate_reference_bundle(contract, model, examples)
+    if change == "source":
+        bundle = replace(bundle, model=replace(bundle.model, source="import os\n"))
+    elif change == "source_hash":
+        bundle = replace(bundle, model=replace(bundle.model, source_sha256="0" * 64))
+    elif change == "examples_hash":
+        bundle = replace(bundle, examples=replace(bundle.examples, proposal_sha256="0" * 64))
+    elif change == "mutable_cases":
+        bundle = replace(bundle, examples=replace(bundle.examples, cases=list(bundle.examples.cases)))
+    else:
+        case = bundle.examples.cases[0]
+        step = replace(case.steps[0], inputs=(("a", 0), ("a", 0)))
+        case = replace(case, steps=(step,))
+        bundle = replace(bundle, examples=replace(bundle.examples, cases=(case,) + bundle.examples.cases[1:]))
+    with pytest.raises(ValueError, match="bundle"):
+        compose_reference_cocotb(bundle, contract)
+
+
+def test_bundle_source_still_has_to_pass_existing_ordinary_test_source_policy():
+    contract, model, examples = materials()
+    model["source"] = "class Model:\n    def evaluate(self, inputs):\n        self._state = 0\n        return {'q': inputs['a']}\n"
+    # This is admitted by the model AST policy but not the ordinary test-source policy.
+    bundle = validate_reference_bundle(contract, model, examples)
+    with pytest.raises(ValueError, match="test_source_policy"):
+        compose_reference_cocotb(bundle, contract)
+
+
+def test_composition_parses_but_never_executes_model_source_on_host():
+    contract, model, examples = materials()
+    model["source"] = "class Model:\n    def evaluate(self, inputs):\n        return {'q': 1 // 0}\n"
+    assert model["source"] in emit(contract, model, examples)
+
+
+def test_declared_sync_steps_include_reset_edge_and_compare_all_post_edge_outputs():
+    contract, model, examples = materials()
+    contract.update(profile="sync_active_low_all_known_after_rising_edge", clock_port="clk", reset_port="rst_n")
+    contract["ports"] += [{"name": name, "direction": "input", "width": 1} for name in ("clk", "rst_n")]
+    digest = contract_digest(contract)
+    model.update(contract_sha256=digest, source=(
+        "class Model:\n    def reset(self):\n        self.q = 0\n"
+        "    def step(self, inputs):\n        if inputs['rst_n'] == 0:\n            self.q = 0\n"
+        "        else:\n            self.q = inputs['a']\n        return {'q': self.q}\n"))
+    examples["contract_sha256"] = digest
+    for case in examples["cases"]:
+        case["steps"][0]["inputs"]["rst_n"] = 1
+        case["steps"].insert(0, {"inputs": {"a": 99, "rst_n": 0}, "expected": {"q": 0}})
+    source = emit(contract, model, examples)
+    assert "model.reset()" in source and "model.step(inputs)" in source
+    assert source.index(".value = 1") < source.index("await ReadOnly()")
+    assert source.index("await ReadOnly()") < source.index("model.step(inputs)")
+    assert source.index("DUT_REFERENCE_MISMATCH") < source.rindex(".value = 0")
+    assert "'rst_n': 0" in source and "'rst_n': 1" in source
+    assert "skip" not in source
+    _validate_test(source)
