@@ -0,0 +1,238 @@
+"""Async reference/example qualification; not integrated into production routing."""
+import asyncio
+import hashlib
+import json
+import math
+import os
+from pathlib import Path
+import re
+import stat
+from uuid import uuid4
+
+from app.agent.reference_bundle import validate_reference_bundle
+from app.eda.sandbox import CommandObservation, CommandResult, DockerSandbox
+
+MAX_OBSERVATION = 65536
+FIELDS = {'version', 'status', 'checked_steps', 'case_index', 'step_index', 'reason'}
+REASONS = {'setup_error': 'setup_exception', 'invalid_output': 'output_shape',
+           'model_error': 'model_exception', 'model_disagreement': 'literal_mismatch'}
+
+
+def interpret_observation(returncode, timed_out, raw, case_lengths):
+    """Reconcile host process facts with a bounded runner observation.
+
+    This interprets evidence; it does not authenticate arbitrary model code or
+    establish semantic correctness. The output deliberately avoids error text.
+    """
+    if timed_out is True:
+        return {'status': 'timeout'}
+    if type(timed_out) is not bool or type(returncode) is not int or returncode != 0:
+        return {'status': 'process_error'}
+    def invalid(): return {'status': 'invalid_observation'}
+    if (type(raw) is not bytes or len(raw) > MAX_OBSERVATION or
+            type(case_lengths) is not list or not case_lengths or len(case_lengths) > 32 or
+            any(type(length) is not int or not 1 <= length <= 256 for length in case_lengths) or
+            sum(case_lengths) > 2048):
+        return invalid()
+    try:
+        def no_constant(_): raise ValueError('non-finite')
+        def unique_pairs(pairs):
+            value = {}
+            for key, item in pairs:
+                if key in value:
+                    raise ValueError('duplicate key')
+                value[key] = item
+            return value
+        data = json.loads(raw, parse_constant=no_constant, object_pairs_hook=unique_pairs)
+    except (UnicodeDecodeError, ValueError, RecursionError):
+        return invalid()
+    if type(data) is not dict or set(data) != FIELDS or type(data['version']) is not int or data['version'] != 1:
+        return invalid()
+    status, count, case, step, reason = (data[k] for k in ('status', 'checked_steps', 'case_index', 'step_index', 'reason'))
+    if type(status) is not str or type(count) is not int or count < 0:
+        return invalid()
+    if status == 'passed':
+        if count != sum(case_lengths) or case is not None or step is not None or reason is not None:
+            return invalid()
+    elif status == 'setup_error':
+        if count != 0 or case is not None or step is not None or reason != REASONS[status]:
+            return invalid()
+    elif status in {'invalid_output', 'model_error', 'model_disagreement'}:
+        if (type(case) is not int or not 0 <= case < len(case_lengths) or type(step) is not int or
+                not 0 <= step < case_lengths[case] or count != sum(case_lengths[:case]) + step or
+                reason != REASONS[status]):
+            return invalid()
+    else:
+        return invalid()
+    return data
+
+
+# Trusted fixed driver is executed only inside the pinned sandbox.
+_DRIVER = '"""Trusted research driver, executed only inside the isolated container.\n\nThe model is untrusted code. Python restrictions are not a security boundary;\nDocker isolation, resource limits and host-side reconciliation remain required.\n"""\nimport builtins\nimport json\nfrom pathlib import Path\n\nALLOWED = (\'abs\', \'all\', \'any\', \'bool\', \'dict\', \'enumerate\', \'int\', \'len\', \'list\',\n           \'max\', \'min\', \'range\', \'reversed\', \'sorted\', \'sum\', \'tuple\', \'zip\', \'__build_class__\')\n\n\ndef observation(status, checked=0, case=None, step=None, reason=None):\n    return {\'version\': 1, \'status\': status, \'checked_steps\': checked,\n            \'case_index\': case, \'step_index\': step, \'reason\': reason}\n\n\ndef evaluate():\n    try:\n        contract = json.loads(Path(\'/input/contract.json\').read_text())\n        cases = json.loads(Path(\'/input/examples.json\').read_text())\n        source = Path(\'/input/model.py\').read_text()\n        namespace = {\'__builtins__\': {name: getattr(builtins, name) for name in ALLOWED},\n                     \'__name__\': \'reference_model\'}\n        exec(compile(source, \'/input/model.py\', \'exec\'), namespace)\n        model_class = namespace[\'Model\']\n        output_widths = {p[\'name\']: p[\'width\'] for p in contract[\'ports\'] if p[\'direction\'] == \'output\'}\n        synchronous = contract[\'profile\'] == \'sync_active_low_all_known_after_rising_edge\'\n    except BaseException:\n        return observation(\'setup_error\', reason=\'setup_exception\')\n    checked = 0\n    for case_index, case in enumerate(cases):\n        try:\n            model = model_class()\n            if synchronous:\n                model.reset()\n        except BaseException:\n            return observation(\'model_error\', checked, case_index, 0, \'model_exception\')\n        for step_index, step in enumerate(case[\'steps\']):\n            try:\n                inputs = dict(step[\'inputs\'])\n                output = model.step(inputs) if synchronous else model.evaluate(inputs)\n            except BaseException:\n                return observation(\'model_error\', checked, case_index, step_index, \'model_exception\')\n            if (type(output) is not dict or set(output) != set(output_widths) or\n                    any(type(output[name]) is not int or not 0 <= output[name] < (1 << width)\n                        for name, width in output_widths.items())):\n                return observation(\'invalid_output\', checked, case_index, step_index, \'output_shape\')\n            if output != step[\'expected\']:\n                return observation(\'model_disagreement\', checked, case_index, step_index, \'literal_mismatch\')\n            checked += 1\n    return observation(\'passed\', checked)\n\n\ndef main():\n    result = evaluate()\n    with Path(\'/output/observation.json\').open(\'x\', encoding=\'utf-8\') as handle:\n        json.dump(result, handle, allow_nan=False, separators=(\',\', \':\'))\n        handle.write(\'\\n\')\n\n\nif __name__ == \'__main__\':\n    main()\n'
+DRIVER_SHA256 = hashlib.sha256(_DRIVER.encode("utf-8")).hexdigest()
+
+
+def _bytes_hash(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+def _read_regular(path, limit):
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    try:
+        info = os.fstat(fd)
+        if not stat.S_ISREG(info.st_mode) or info.st_nlink != 1 or info.st_size > limit:
+            raise ValueError('Precheck evidence file is unsafe or oversized')
+        chunks, count = [], 0
+        while True:
+            block = os.read(fd, min(65536, limit + 1 - count))
+            if not block:
+                break
+            chunks.append(block); count += len(block)
+            if count > limit:
+                raise ValueError('Precheck evidence file exceeds its bound')
+        return b''.join(chunks)
+    finally:
+        os.close(fd)
+
+
+def _write_new(path, contents):
+    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+    with os.fdopen(fd, 'wb') as output:
+        output.write(contents)
+        output.flush()
+        os.fsync(output.fileno())
+
+
+def _new_snapshot(work_dir):
+    root = Path(work_dir).resolve(strict=True)
+    if not root.is_dir():
+        raise ValueError('Precheck work directory is unavailable')
+    descriptor = os.open(root, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
+    try:
+        try:
+            os.mkdir('.eda', mode=0o700, dir_fd=descriptor)
+        except FileExistsError:
+            pass
+        eda = os.open('.eda', os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=descriptor)
+        try:
+            name = 'reference_precheck_' + uuid4().hex
+            os.mkdir(name, mode=0o700, dir_fd=eda)
+            run = os.open(name, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW, dir_fd=eda)
+            try:
+                os.mkdir('input', mode=0o700, dir_fd=run)
+                os.mkdir('output', mode=0o700, dir_fd=run)
+            finally:
+                os.close(run)
+        finally:
+            os.close(eda)
+    finally:
+        os.close(descriptor)
+    return root, root/'.eda'/name/'input', root/'.eda'/name/'output'
+
+
+def _json_bytes(value):
+    return (json.dumps(value, sort_keys=True, separators=(',', ':'), allow_nan=False) + '\n').encode('utf-8')
+
+
+def _observed_command(observations, result, command, input_dir, output_dir):
+    if len(observations) != 1 or not isinstance(observations[0], CommandObservation):
+        return None
+    observed = observations[0]
+    if (tuple(command) != observed.command or observed.input_dir != input_dir or observed.output_dir != output_dir or
+            type(observed.process_launched) is not bool or type(observed.result.returncode) is not int or
+            type(observed.result.timed_out) is not bool or not isinstance(observed.duration_seconds, (int, float)) or
+            isinstance(observed.duration_seconds, bool) or not math.isfinite(observed.duration_seconds) or
+            observed.duration_seconds < 0):
+        return None
+    if result is not None and (not isinstance(result, CommandResult) or result.returncode != observed.result.returncode or
+                               result.timed_out is not observed.result.timed_out or result.log_path != observed.result.log_path or
+                               result.cleanup_unconfirmed is not observed.result.cleanup_unconfirmed):
+        return None
+    return {'returncode': observed.result.returncode, 'timed_out': observed.result.timed_out,
+            'process_launched': observed.process_launched, 'duration_seconds': observed.duration_seconds}
+
+
+async def run_precheck(contract, model, examples, *, work_dir, sandbox, timeout=60):
+    """Check bounded reference examples in Docker; never execute proposal on host.
+
+    `sandbox` must already be pinned to an immutable image ID. This operation
+    does not prove model independence, code safety, or RTL correctness.
+    """
+    bundle = validate_reference_bundle(contract, model, examples)
+    if not isinstance(sandbox, DockerSandbox):
+        raise ValueError('Precheck requires a pinned Docker image ID')
+    image_id, pdk_dir, user, completion_callback = (
+        sandbox.image, sandbox.pdk_dir, sandbox.user, sandbox.completion_callback)
+    if not isinstance(image_id, str) or re.fullmatch(r'sha256:[0-9a-f]{64}', image_id) is None:
+        raise ValueError('Precheck requires a pinned Docker image ID')
+    if type(timeout) not in (int, float) or not math.isfinite(timeout) or not 0 < timeout <= 60:
+        raise ValueError('Precheck timeout must be positive and at most 60 seconds')
+    root, input_dir, output_dir = _new_snapshot(work_dir)
+    frozen = {'profile': bundle.contract.profile, 'clock_port': bundle.contract.clock_port,
+              'reset_port': bundle.contract.reset_port,
+              'ports': [{'name': n, 'direction': d, 'width': w} for n,d,w in bundle.contract.ports]}
+    cases = [{'name': case.name, 'steps': [{'inputs': dict(step.inputs), 'expected': dict(step.expected)}
+                                         for step in case.steps]} for case in bundle.examples.cases]
+    files = {'model.py': bundle.model.source.encode('utf-8'), 'contract.json': _json_bytes(frozen),
+             'examples.json': _json_bytes(cases), 'driver.py': _DRIVER.encode('utf-8')}
+    for name, data in files.items():
+        _write_new(input_dir/name, data)
+    before = {name: _bytes_hash(data) for name,data in files.items()}
+    if before['model.py'] != bundle.model.source_sha256:
+        raise ValueError('Model bytes do not match validated proposal')
+    observations, callback_failures = [], []
+    def observe(item):
+        observations.append(item)
+        if completion_callback is not None:
+            try:
+                completion_callback(item)
+            except BaseException as error:
+                callback_failures.append(error)
+    tracked = DockerSandbox(image=image_id, pdk_dir=pdk_dir, user=user, completion_callback=observe)
+    command = ['python3', '-I', '-B', '/input/driver.py']
+    result = None; primary = None
+    try:
+        result = await tracked.run(command, input_dir=input_dir, output_dir=output_dir, timeout=timeout)
+    except BaseException as error:
+        primary = error
+    try:
+        after = {name: _bytes_hash(_read_regular(input_dir/name, 65536)) for name in files}
+        command_result = _observed_command(observations, result, command, input_dir, output_dir)
+        try:
+            raw = _read_regular(output_dir/'observation.json', MAX_OBSERVATION)
+        except (OSError, ValueError):
+            raw = None
+        lengths = [len(case.steps) for case in bundle.examples.cases]
+        if primary is not None:
+            status, observation = 'cancelled' if isinstance(primary, asyncio.CancelledError) else 'process_error', None
+        elif isinstance(result, CommandResult) and result.cleanup_unconfirmed:
+            status, observation = 'cleanup_error', None
+        elif callback_failures or command_result is None:
+            status, observation = 'observation_error', None
+        elif not command_result['process_launched']:
+            status, observation = 'process_error', None
+        elif before != after:
+            status, observation = 'input_changed', None
+        else:
+            observation = interpret_observation(command_result['returncode'], command_result['timed_out'], raw, lengths)
+            status = observation['status']
+        receipt_path = (output_dir/'receipt.json').relative_to(root).as_posix()
+        receipt = {'schema_version': 1, 'status': status, 'image_id': image_id,
+                   'contract_sha256': bundle.contract_sha256, 'model_sha256': bundle.model.source_sha256,
+                   'examples_sha256': bundle.examples.proposal_sha256, 'driver_sha256': before['driver.py'],
+                   'cases_count': len(lengths), 'steps_count': sum(lengths), 'command': command_result,
+                   'observation': observation, 'observation_sha256': _bytes_hash(raw) if raw is not None else None,
+                   'input_sha256_before': before, 'input_sha256_after': after, 'receipt_path': receipt_path}
+        _write_new(output_dir/'receipt.json', _json_bytes(receipt))
+    except BaseException as error:
+        if primary is not None:
+            primary.add_note(f'Precheck evidence finalization failed ({type(error).__name__}); receipt not confirmed.')
+            raise primary from None
+        raise
+    if primary is not None:
+        if callback_failures:
+            primary.add_note('Precheck observer failed; command trace incomplete.')
+        raise primary
+    if callback_failures and not isinstance(callback_failures[0], Exception):
+        raise callback_failures[0]
+    return receipt
