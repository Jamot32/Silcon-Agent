+def test_cancel_during_creation_reaps_the_eventual_owned_child(tmp_path, monkeypatch):
+    async def scenario():
+        begun = asyncio.Event(); release = asyncio.Event(); commands = []; observed = []
+        class Child:
+            returncode = None
+            def kill(self): self.returncode = -9
+            async def wait(self):
+                if self.returncode is None:
+                    await asyncio.Future()
+                return self.returncode
+        child = Child()
+        class Cleanup:
+            returncode = 0
+            async def wait(self): return 0
+        async def spawn(*args, **kwargs):
+            commands.append(args)
+            if args[:2] == ('docker', 'run'):
+                begun.set(); await release.wait(); return child
+            assert args[:3] == ('docker', 'rm', '-f')
+            return Cleanup()
+        monkeypatch.setattr(asyncio, 'create_subprocess_exec', spawn)
+        task = asyncio.create_task(DockerSandbox(completion_callback=observed.append).run(
+            ['true'], input_dir=tmp_path, output_dir=tmp_path/'out', timeout=3))
+        await begun.wait(); task.cancel(); await asyncio.sleep(0); release.set()
+        with pytest.raises(asyncio.CancelledError): await task
+        run = commands[0]; name = run[run.index('--name')+1]
+        assert commands[1] == ('docker', 'rm', '-f', name)
+        assert child.returncode == -9
+        assert len(observed) == 1 and observed[0].process_launched is True
+        assert observed[0].result.timed_out is True
+    asyncio.run(scenario())
