+"""Synthetic data-consistency controls, never real EDA or attestation evidence."""
+from copy import deepcopy
+import hashlib
+import json
+
+import pytest
+
+from app.eda.reference_proof import ReferenceProofError, validate_reference_proof
+
+
+def digest(raw):
+    return hashlib.sha256(raw).hexdigest()
+
+
+def material():
+    image = "sha256:" + "9" * 64
+    inputs = {"model.py": "c" * 64, "contract.json": "e" * 64,
+              "examples.json": "f" * 64, "driver.py": "d" * 64}
+    identity = {"schema_version": 1, "top": "neutral_top", "image_id": image,
+                "sources": {"src/neutral_top.v": "a" * 64},
+                "tests": {"test/test_reference.py": "b" * 64},
+                "contract_sha256": "1" * 64, "model_sha256": "c" * 64,
+                "examples_sha256": "2" * 64, "driver_sha256": "d" * 64,
+                "precheck_inputs": inputs, "reference_cases": 2, "reference_steps": 7,
+                "test_names": ["test_reset", "test_normal", "test_hold", "test_edge"]}
+    observation = {"version": 1, "status": "passed", "checked_steps": 7,
+                   "case_index": None, "step_index": None, "reason": None}
+    raw = json.dumps(observation, separators=(",", ":")).encode() + b"\n"
+    command = {"returncode": 0, "timed_out": False, "process_launched": True,
+               "duration_seconds": 0.5}
+    precheck = {"schema_version": 1, "status": "passed", "image_id": image,
+                "contract_sha256": identity["contract_sha256"], "model_sha256": identity["model_sha256"],
+                "examples_sha256": identity["examples_sha256"], "driver_sha256": identity["driver_sha256"],
+                "cases_count": 2, "steps_count": 7, "command": deepcopy(command),
+                "observation_sha256": digest(raw), "observation": observation,
+                "input_sha256_before": deepcopy(inputs), "input_sha256_after": deepcopy(inputs)}
+    xml = ('<testsuites tests="4" failures="0" errors="0" skipped="0"><testsuite tests="4">'
+           + ''.join(f'<testcase name="{n}"/>' for n in identity["test_names"])
+           + '</testsuite></testsuites>').encode()
+    files = {**identity["sources"], **identity["tests"]}
+    simulation = {"schema_version": 1, "identity": deepcopy(identity), "command": command,
+                  "input_sha256_before": deepcopy(files), "input_sha256_after": deepcopy(files),
+                  "xml_sha256": digest(xml),
+                  "result": {"ok": True, "passed": 4, "failed": 0, "skipped": 0,
+                             "cases": [{"test": n, "ok": True} for n in identity["test_names"]]}}
+    return identity, precheck, simulation, raw, xml
+
+
+def validate(data, **kwargs):
+    identity, precheck, simulation, raw, xml = data
+    return validate_reference_proof(identity, precheck, simulation,
+                                    precheck_observation=raw, simulator_xml=xml, **kwargs)
+
+
+def test_complete_reference_and_simulator_data_binds_exact_identity_without_execution():
+    identity, precheck, simulation, raw, xml = material()
+    proof = validate((identity, precheck, simulation, raw, xml))
+    assert proof.test_names == tuple(identity["test_names"])
+    assert proof.xml_sha256 == digest(xml)
+    assert proof.reference_steps == 7
+    assert proof.assurance == "data_consistency_only"
+
+
+@pytest.mark.parametrize("path,value", [
+    ((0, "schema_version"), True), ((0, "top"), "../bad"), ((0, "image_id"), "mutable:latest"),
+    ((0, "sources"), {}), ((0, "tests"), {}),
+    ((0, "sources"), {"../escape.v": "a" * 64}),
+    ((0, "tests"), {"test/a.py": "not-a-hash"}),
+    ((0, "reference_cases"), True), ((0, "reference_steps"), 0),
+    ((0, "test_names"), ["same"] * 4),
+    ((1, "status"), "model_disagreement"), ((1, "schema_version"), 1.0),
+    ((1, "image_id"), "sha256:" + "8" * 64),
+    ((1, "contract_sha256"), "0" * 64), ((1, "model_sha256"), "0" * 64),
+    ((1, "examples_sha256"), "0" * 64), ((1, "driver_sha256"), "0" * 64),
+    ((1, "cases_count"), 1), ((1, "steps_count"), 6),
+    ((1, "observation_sha256"), "0" * 64),
+    ((1, "input_sha256_before", "model.py"), "0" * 64),
+    ((1, "input_sha256_after", "contract.json"), "0" * 64),
+    ((1, "observation", "checked_steps"), True),
+    ((2, "identity", "top"), "other_top"),
+    ((2, "identity", "sources", "src/neutral_top.v"), "0" * 64),
+    ((2, "identity", "tests", "test/test_reference.py"), "0" * 64),
+    ((2, "identity", "contract_sha256"), "0" * 64),
+    ((2, "identity", "model_sha256"), "0" * 64),
+    ((2, "identity", "examples_sha256"), "0" * 64),
+    ((2, "input_sha256_after", "src/neutral_top.v"), "0" * 64),
+    ((2, "xml_sha256"), "0" * 64), ((2, "result", "ok"), 1),
+    ((2, "result", "passed"), 4.0), ((2, "result", "failed"), False),
+    ((2, "result", "skipped"), 1),
+])
+def test_mismatched_or_untyped_binding_facts_are_rejected(path, value):
+    data = list(material()); target = data
+    for part in path[:-1]: target = target[part]
+    target[path[-1]] = value
+    with pytest.raises(ReferenceProofError): validate(data)
+
+
+@pytest.mark.parametrize("stage", [1, 2])
+@pytest.mark.parametrize("field,value", [
+    ("returncode", 1), ("returncode", False), ("returncode", 0.0),
+    ("timed_out", True), ("timed_out", 0), ("process_launched", False),
+    ("duration_seconds", float("nan")), ("duration_seconds", -1),
+])
+def test_both_host_command_observations_require_closed_success(stage, field, value):
+    data = list(material()); data[stage]["command"][field] = value
+    with pytest.raises(ReferenceProofError): validate(data)
+
+
+@pytest.mark.parametrize("stage,key", [(0,"top"),(1,"command"),(1,"observation"),
+                                       (2,"identity"),(2,"xml_sha256"),(2,"result")])
+def test_missing_required_evidence_is_not_inferred(stage, key):
+    data = list(material()); del data[stage][key]
+    with pytest.raises(ReferenceProofError): validate(data)
+
+
+@pytest.mark.parametrize("xml", [
+    b"<testsuites/>", b"not XML", b"<!DOCTYPE x><testsuites/>",
+    b'<testsuite><testcase name="one"><skipped/></testcase></testsuite>',
+    b'<testsuite><testcase name="one"><failure/></testcase></testsuite>',
+    b'<testsuite><testcase name="one"><error/></testcase></testsuite>',
+    b'<testsuite>' + b'<testcase name="same"/>' * 4 + b'</testsuite>',
+    b'<testsuite>' + b'<testcase/>' * 4 + b'</testsuite>',
+    b'<testsuite tests="5">' + b'<testcase name="one"/>' + b'</testsuite>',
+    b'<testsuites xmlns="unexpected"><testcase name="one"/></testsuites>',
+])
+def test_xml_content_is_checked_after_matching_its_bytes_hash(xml):
+    data = list(material()); data[4] = xml; data[2]["xml_sha256"] = digest(xml)
+    with pytest.raises(ReferenceProofError): validate(data)
+
+
+@pytest.mark.parametrize("fault", ["case_name", "case_ok", "count", "duplicate", "missing"])
+def test_simulator_result_cases_and_counts_reconcile_with_xml(fault):
+    data = list(material()); result = data[2]["result"]
+    if fault == "case_name": result["cases"][0]["test"] = "not_expected"
+    elif fault == "case_ok": result["cases"][0]["ok"] = False
+    elif fault == "count": result["passed"] = 3
+    elif fault == "duplicate": result["cases"][1] = deepcopy(result["cases"][0])
+    else: result["cases"].pop()
+    with pytest.raises(ReferenceProofError): validate(data)
+
+
+@pytest.mark.parametrize("minimum", [True, 1, 5, 1001])
+def test_minimum_is_strict_and_four_tests_are_not_enough_for_a_higher_floor(minimum):
+    with pytest.raises(ReferenceProofError): validate(material(), minimum_tests=minimum)
+
+
+def test_raw_precheck_observation_and_hash_must_match_validated_full_step_success():
+    for raw in [b'{"version":1,"version":1}', b'{', b' ' * 65537,
+                b'{"version":1,"status":"passed","checked_steps":8,"case_index":null,"step_index":null,"reason":null}']:
+        data = list(material()); data[3] = raw; data[1]["observation_sha256"] = digest(raw)
+        with pytest.raises(ReferenceProofError): validate(data)
+
+
+def test_returned_proof_is_detached_from_mutable_caller_inputs():
+    data = material(); proof = validate(data); data[0]["test_names"][0] = "changed"
+    assert proof.test_names[0] == "test_reset"
+
+
+def test_proof_digest_binds_both_successful_normalized_evidence_records():
+    data = material(); first = validate(data)
+    changed = deepcopy(data); changed[1]["command"]["duration_seconds"] = 0.75
+    second = validate(changed)
+    assert first.identity_sha256 == second.identity_sha256
+    assert first.evidence_sha256 != second.evidence_sha256
+    changed = deepcopy(data); changed[2]["command"]["duration_seconds"] = 0.75
+    assert first.evidence_sha256 != validate(changed).evidence_sha256
+
+
+def test_supported_single_suite_and_reordered_xml_still_require_exact_unique_names():
+    data = list(material()); names = list(reversed(data[0]["test_names"]))
+    xml = ('<testsuite tests="4" failures="0" errors="0" skipped="0">'
+           + ''.join(f'<testcase name="{n}"/>' for n in names) + '</testsuite>').encode()
+    data[4] = xml; data[2]["xml_sha256"] = digest(xml)
+    assert validate(data).test_names == tuple(names)
+
+
+def test_matching_hash_does_not_allow_wrong_names_utf16_or_oversized_xml():
+    for raw in [material()[4].replace(b'test_reset', b'other_case'),
+                '<!DOCTYPE x><testsuites/>'.encode('utf-16'), b' ' * (2 * 1024 * 1024 + 1)]:
+        data = list(material()); data[4] = raw; data[2]["xml_sha256"] = digest(raw)
+        with pytest.raises(ReferenceProofError): validate(data)
+
+
+@pytest.mark.parametrize("section", [0, 1, 2])
+def test_unknown_fields_and_non_record_sections_fail_closed(section):
+    data = list(material()); data[section]["unknown"] = "not normalized evidence"
+    with pytest.raises(ReferenceProofError): validate(data)
+    data = list(material()); data[section] = None
+    with pytest.raises(ReferenceProofError): validate(data)
