new file mode 100644
index 0000000..32fee16
--- /dev/null
+++ b/backend/app/agent/reference_bundle.py
@@ -0,0 +1,368 @@
+"""Data-only reference proposals. Validation never executes generated Python.
+
+Author IDs establish binding only, not independent reasoning or correctness.
+This research boundary is not selected by the production orchestrator.
+"""
+from dataclasses import dataclass
+import ast
+import hashlib
+import json
+import re
+
+MAX_PORTS = 64
+MAX_WIDTH = 1024
+MAX_SOURCE_BYTES = 32768
+MAX_EXAMPLE_BYTES = 65536
+MAX_CASES = 32
+MAX_STEPS_PER_CASE = 256
+MAX_TOTAL_STEPS = 2048
+MAX_AST_NODES = 4096
+_IDENTIFIER = re.compile(r"[A-Za-z_][A-Za-z0-9_]{0,63}\Z")
+_CALL_ID = re.compile(r"[a-f0-9]{32}\Z")
+_SHA256 = re.compile(r"[a-f0-9]{64}\Z")
+COMBINATIONAL = "combinational_all_known"
+SYNCHRONOUS = "sync_active_low_all_known_after_rising_edge"
+_BUILTINS = {"abs", "all", "any", "bool", "dict", "enumerate", "int", "len", "list",
+             "max", "min", "range", "reversed", "sorted", "sum", "tuple", "zip"}
+_COLLECTION_METHODS = {"append", "clear", "copy", "get", "items", "keys", "pop", "values", "bit_count"}
+_NODES = {
+    ast.Module, ast.ClassDef, ast.FunctionDef, ast.arguments, ast.arg, ast.Expr,
+    ast.Assign, ast.AugAssign, ast.Return, ast.If, ast.For, ast.Break, ast.Continue,
+    ast.Pass, ast.Name, ast.Load, ast.Store, ast.Constant, ast.Attribute,
+    ast.Subscript, ast.Slice, ast.Dict, ast.List, ast.Tuple, ast.Call, ast.IfExp,
+    ast.BinOp, ast.UnaryOp, ast.BoolOp, ast.Compare,
+    ast.Add, ast.Sub, ast.Mult, ast.FloorDiv, ast.Mod, ast.LShift, ast.RShift,
+    ast.BitAnd, ast.BitOr, ast.BitXor, ast.Invert, ast.Not, ast.UAdd, ast.USub,
+    ast.And, ast.Or, ast.Eq, ast.NotEq, ast.Lt, ast.LtE, ast.Gt, ast.GtE,
+    ast.Is, ast.IsNot, ast.In, ast.NotIn,
+}
+
+
+class BundleValidationError(ValueError):
+    """A reference/example admission error, never an RTL functional verdict."""
+
+
+class UnsupportedObservationError(BundleValidationError):
+    """The caller must not substitute a mask, latency or reset interpretation."""
+
+
+@dataclass(frozen=True)
+class ReferenceContract:
+    profile: str
+    clock_port: str | None
+    reset_port: str | None
+    ports: tuple[tuple[str, str, int], ...]
+
+
+@dataclass(frozen=True)
+class ModelMaterial:
+    source: str
+    author_call_id: str
+    source_sha256: str
+
+
+@dataclass(frozen=True)
+class DirectedStep:
+    inputs: tuple[tuple[str, int], ...]
+    expected: tuple[tuple[str, int], ...]
+
+
+@dataclass(frozen=True)
+class DirectedCase:
+    name: str
+    steps: tuple[DirectedStep, ...]
+
+
+@dataclass(frozen=True)
+class ExampleMaterial:
+    author_call_id: str
+    cases: tuple[DirectedCase, ...]
+    proposal_sha256: str
+
+
+@dataclass(frozen=True)
+class ReferenceBundle:
+    contract: ReferenceContract
+    model: ModelMaterial
+    examples: ExampleMaterial
+    contract_sha256: str
+
+
+def _need(condition: bool, message: str) -> None:
+    if not condition:
+        raise BundleValidationError(message)
+
+
+def _record(value: object, keys: set[str], label: str) -> dict:
+    _need(type(value) is dict and all(type(k) is str for k in value),
+          f"{label} must be a plain JSON object")
+    _need(set(value) == keys, f"{label} has missing or unknown fields")
+    return value
+
+
+def _version(value: object) -> None:
+    _need(type(value) is int and value == 1, "schema_version must be integer 1")
+
+
+def _name(value: object, label: str) -> str:
+    _need(type(value) is str and _IDENTIFIER.fullmatch(value) is not None,
+          f"{label} must be a plain identifier of at most 64 characters")
+    return value
+
+
+def _sequence(value: object, maximum: int, label: str) -> list:
+    _need(type(value) is list and 1 <= len(value) <= maximum,
+          f"{label} must contain 1..{maximum} entries")
+    return value
+
+
+def _digest(value: dict) -> str:
+    raw = json.dumps(value, sort_keys=True, separators=(",", ":"),
+                     ensure_ascii=False, allow_nan=False).encode("utf-8")
+    return hashlib.sha256(raw).hexdigest()
+
+
+def validate_contract(contract: dict) -> ReferenceContract:
+    """Validate declared observation support; this does not infer it from prose."""
+    c = _record(contract, {"schema_version", "profile", "clock_port", "reset_port", "ports"}, "contract")
+    _version(c["schema_version"])
+    _need(type(c["profile"]) is str, "profile must be a string")
+    if c["profile"] not in {COMBINATIONAL, SYNCHRONOUS}:
+        raise UnsupportedObservationError("Only fully known combinational or synchronous post-edge observations are supported")
+    ports = []
+    names = set()
+    for raw in _sequence(c["ports"], MAX_PORTS, "ports"):
+        p = _record(raw, {"name", "direction", "width"}, "port")
+        name = _name(p["name"], "port name")
+        _need(name not in names, "Port names must be unique")
+        names.add(name)
+        _need(type(p["direction"]) is str and p["direction"] in {"input", "output"},
+              "Port direction must be input or output; inout is unsupported")
+        _need(type(p["width"]) is int and 1 <= p["width"] <= MAX_WIDTH,
+              f"Port width must be an integer in 1..{MAX_WIDTH}")
+        ports.append((name, p["direction"], p["width"]))
+    _need(any(direction == "output" for _, direction, _ in ports), "Contract needs an observable output")
+    if c["profile"] == COMBINATIONAL:
+        _need(c["clock_port"] is None and c["reset_port"] is None,
+              "Combinational contracts have no clock or reset roles")
+    else:
+        clock = _name(c["clock_port"], "clock_port")
+        reset = _name(c["reset_port"], "reset_port")
+        _need(clock != reset, "Clock and reset roles must be distinct")
+        _need((clock, "input", 1) in ports and (reset, "input", 1) in ports,
+              "Clock and synchronous active-low reset must be one-bit input ports")
+    return ReferenceContract(c["profile"], c["clock_port"], c["reset_port"], tuple(sorted(ports)))
+
+
+def contract_digest(contract: dict) -> str:
+    """Bind the exact validated JSON contract, including its declared port order."""
+    validate_contract(contract)
+    return _digest(contract)
+
+
+def _proposal(value: dict, keys: set[str], digest: str, label: str) -> dict:
+    value = _record(value, keys | {"schema_version", "contract_sha256", "author_call_id"}, label)
+    _version(value["schema_version"])
+    _need(type(value["contract_sha256"]) is str and _SHA256.fullmatch(value["contract_sha256"]) is not None
+          and value["contract_sha256"] == digest, f"{label} must bind the exact contract digest")
+    _need(type(value["author_call_id"]) is str and _CALL_ID.fullmatch(value["author_call_id"]) is not None,
+          f"{label} author_call_id must be a 32-character lowercase hex ID")
+    return value
+
+
+def _docstring(node: ast.AST) -> bool:
+    return isinstance(node, ast.Expr) and isinstance(node.value, ast.Constant) and type(node.value.value) is str
+
+
+def _explicit_return(block: list[ast.stmt]) -> bool:
+    """Conservative fallthrough check, not proof of runtime success/termination."""
+    for statement in block:
+        if type(statement) is ast.Return:
+            return True
+        if (type(statement) is ast.If and _explicit_return(statement.body)
+                and _explicit_return(statement.orelse)):
+            return True
+    return False
+
+
+def _loop_control(node: ast.AST, depth: int = 0) -> None:
+    # The admitted AST node count already bounds this work stack. Expression
+    # depth must not consume the host Python call stack.
+    pending = [(node, depth)]
+    while pending:
+        current, current_depth = pending.pop()
+        if type(current) in {ast.Break, ast.Continue}:
+            _need(current_depth > 0, "Loop control must occur inside a for-loop body")
+        if type(current) is ast.For:
+            pending.extend((statement, current_depth + 1) for statement in current.body)
+            # The loop's own else suite is outside that loop's control scope.
+            pending.extend((statement, current_depth) for statement in current.orelse)
+            pending.extend(((current.target, current_depth), (current.iter, current_depth)))
+        else:
+            pending.extend((child, current_depth) for child in ast.iter_child_nodes(current))
+
+
+def _model_source(contract: ReferenceContract, source: str) -> None:
+    """Bounded syntax/import policy, NOT a purity proof or security boundary.
+
+    ast.parse produces syntax only. Never compile/evaluate/import/instantiate the
+    proposal on the host. A future executor must remain inside the EDA sandbox.
+    Profile declarations cannot establish temporal semantics from source strings.
+    """
+    try:
+        tree = ast.parse(source)
+    except (SyntaxError, ValueError, RecursionError):
+        raise BundleValidationError("Model source is not supported Python syntax") from None
+    nodes = list(ast.walk(tree))
+    _need(len(nodes) <= MAX_AST_NODES, f"Model exceeds {MAX_AST_NODES} AST nodes")
+    _need(all(type(n) in _NODES for n in nodes), "Model uses an unsupported syntax/import construct")
+    _need(sum(type(n) is ast.ClassDef for n in nodes) == 1, "Nested classes are unsupported")
+    parents = {child: parent for parent in nodes for child in ast.iter_child_nodes(parent)}
+    body = [n for n in tree.body if not _docstring(n)]
+    _need(len(body) == 1 and type(body[0]) is ast.ClassDef and body[0].name == "Model",
+          "Model source must contain exactly one class Model")
+    cls = body[0]
+    _need(not cls.bases and not cls.keywords and not cls.decorator_list and not getattr(cls, "type_params", ()),
+          "Model class cannot have bases, decorators, keywords or type parameters")
+    methods = [n for n in cls.body if not _docstring(n)]
+    _need(1 <= len(methods) <= 32 and all(type(n) is ast.FunctionDef for n in methods),
+          "Model class may contain only plain methods")
+    names = [n.name for n in methods]
+    _need(len(names) == len(set(names)), "Model methods must be unique")
+    output_method = "evaluate" if contract.profile == COMBINATIONAL else "step"
+    required = {output_method} if contract.profile == COMBINATIONAL else {"reset", "step"}
+    _need(required <= set(names), "Model is missing the required evaluate or reset/step ABI")
+    _need(not ({"step", "reset"} if contract.profile == COMBINATIONAL else {"evaluate"}) & set(names),
+          "Model methods do not match the declared observation profile")
+    inputs = {n for n, d, _ in contract.ports if d == "input" and n != contract.clock_port}
+    outputs = {n for n, d, _ in contract.ports if d == "output"}
+    for method in methods:
+        _need(method.name == "__init__" or (_IDENTIFIER.fullmatch(method.name) is not None
+              and not method.name.startswith("__")), "Unsupported model method name")
+        args = method.args
+        _need(not method.decorator_list and method.returns is None and not getattr(method, "type_params", ())
+              and not args.posonlyargs and not args.vararg and not args.kwarg and not args.kwonlyargs
+              and not args.defaults and not args.kw_defaults
+              and all(a.annotation is None for a in args.args),
+              "Model methods cannot use decorators, annotations or flexible/default arguments")
+        actual = [a.arg for a in args.args]
+        _need(len(actual) == len(set(actual)), "Model method parameter names must be unique")
+        _need(actual and actual[0] == "self", "Model methods need self as first parameter")
+        expected = ["self", "inputs"] if method.name == output_method else ["self"]
+        if method.name in required | {"__init__"}:
+            _need(actual == expected, "Use evaluate/step(self, inputs) and reset/__init__(self)")
+        if method.name == output_method:
+            _need(_explicit_return(method.body), "Output method must explicitly return on every structural path")
+            returns = [n for n in ast.walk(method) if isinstance(n, ast.Return)]
+            _need(bool(returns), "Output method needs an explicit literal output dictionary")
+            for node in returns:
+                value = node.value
+                _need(type(value) is ast.Dict and all(type(k) is ast.Constant and type(k.value) is str for k in value.keys),
+                      "Every output-method return must be a literal output dictionary")
+                keys = [k.value for k in value.keys]
+                _need(len(keys) == len(set(keys)) and set(keys) == outputs,
+                      "Returned output dictionary must contain exactly the declared outputs")
+        _loop_control(method)
+    _need(sum(type(n) is ast.FunctionDef for n in nodes) == len(methods), "Nested functions are unsupported")
+    for node in nodes:
+        if isinstance(node, ast.Name):
+            _need(not node.id.startswith("__"), "Dunder names are unsupported")
+            if node.id == "inputs":
+                parent = parents.get(node)
+                direct_read = (type(parent) is ast.Subscript and parent.value is node
+                               and type(parent.ctx) is ast.Load)
+                get_read = (type(parent) is ast.Attribute and parent.value is node
+                            and parent.attr == "get" and type(parents.get(parent)) is ast.Call
+                            and parents[parent].func is parent)
+                _need(type(node.ctx) is ast.Load and (direct_read or get_read),
+                      "Inputs allow only direct literal-key reads/get calls; aliases and writes are unsupported")
+        if isinstance(node, ast.Attribute):
+            _need(not node.attr.startswith("__") and
+                  ((isinstance(node.value, ast.Name) and node.value.id == "self")
+                   or node.attr in _COLLECTION_METHODS), "Unsupported model attribute access")
+        if isinstance(node, ast.Call):
+            target = node.func
+            direct = isinstance(target, ast.Name) and target.id in _BUILTINS
+            member = isinstance(target, ast.Attribute) and (
+                target.attr in _COLLECTION_METHODS or
+                (isinstance(target.value, ast.Name) and target.value.id == "self" and target.attr in names))
+            _need((direct or member) and not node.keywords, "Model call is outside the bounded builtin/method policy")
+            if (isinstance(target, ast.Attribute) and target.attr == "get"
+                    and isinstance(target.value, ast.Name) and target.value.id == "inputs"):
+                _need(bool(node.args) and type(node.args[0]) is ast.Constant
+                      and type(node.args[0].value) is str and node.args[0].value in inputs,
+                      "Model input get must name a declared data/reset pin")
+        if isinstance(node, ast.Subscript) and isinstance(node.value, ast.Name) and node.value.id == "inputs":
+            _need(type(node.slice) is ast.Constant and type(node.slice.value) is str and node.slice.value in inputs,
+                  "Model inputs must use literal declared data/reset pin names; clock is host-owned")
+
+
+def _model(contract: ReferenceContract, proposal: dict, digest: str) -> ModelMaterial:
+    value = _proposal(proposal, {"source"}, digest, "model")
+    source = value["source"]
+    _need(type(source) is str and source.strip(), "Model source must be nonempty text")
+    try:
+        raw = source.encode("utf-8")
+    except UnicodeError:
+        raise BundleValidationError("Model source must be valid UTF-8") from None
+    _need(len(raw) <= MAX_SOURCE_BYTES, f"Model source exceeds {MAX_SOURCE_BYTES} UTF-8 bytes")
+    _model_source(contract, source)
+    return ModelMaterial(source, value["author_call_id"], hashlib.sha256(raw).hexdigest())
+
+
+def _pin_values(value: dict, ports: dict[str, int], label: str) -> tuple[tuple[str, int], ...]:
+    value = _record(value, set(ports), label)
+    for name, width in ports.items():
+        literal = value[name]
+        _need(type(literal) is int and 0 <= literal < (1 << width),
+              f"{label}.{name} must be an unsigned integer fitting its port width")
+    return tuple(sorted(value.items()))
+
+
+def _examples(contract: ReferenceContract, proposal: dict, digest: str) -> ExampleMaterial:
+    value = _proposal(proposal, {"cases"}, digest, "examples")
+    inputs = {n: w for n, d, w in contract.ports if d == "input" and n != contract.clock_port}
+    outputs = {n: w for n, d, w in contract.ports if d == "output"}
+    cases = []
+    names = set()
+    total = 0
+    for raw_case in _sequence(value["cases"], MAX_CASES, "cases"):
+        case = _record(raw_case, {"name", "steps"}, "case")
+        name = _name(case["name"], "case name")
+        _need(name not in names, "Case names must be unique")
+        names.add(name)
+        steps = []
+        for raw_step in _sequence(case["steps"], MAX_STEPS_PER_CASE, "steps"):
+            total += 1
+            _need(total <= MAX_TOTAL_STEPS, f"Examples exceed {MAX_TOTAL_STEPS} total steps")
+            step = _record(raw_step, {"inputs", "expected"}, "step")
+            steps.append(DirectedStep(_pin_values(step["inputs"], inputs, "inputs"),
+                                      _pin_values(step["expected"], outputs, "expected")))
+        if contract.profile == SYNCHRONOUS:
+            _need(dict(steps[0].inputs)[contract.reset_port] == 0,
+                  "Each synchronous case must begin with an asserted reset edge")
+        cases.append(DirectedCase(name, tuple(steps)))
+    byte_count = 0
+    encoder = json.JSONEncoder(sort_keys=True, separators=(",", ":"), ensure_ascii=False, allow_nan=False)
+    for chunk in encoder.iterencode(value):
+        byte_count += len(chunk.encode("utf-8"))
+        _need(byte_count <= MAX_EXAMPLE_BYTES, f"Example proposal exceeds {MAX_EXAMPLE_BYTES} canonical UTF-8 bytes")
+    return ExampleMaterial(value["author_call_id"], tuple(cases), _digest(value))
+
+
+def validate_model(contract: dict, proposal: dict) -> ModelMaterial:
+    return _model(validate_contract(contract), proposal, contract_digest(contract))
+
+
+def validate_examples(contract: dict, proposal: dict) -> ExampleMaterial:
+    return _examples(validate_contract(contract), proposal, contract_digest(contract))
+
+
+def validate_reference_bundle(contract: dict, model: dict, examples: dict) -> ReferenceBundle:
+    frozen = validate_contract(contract)
+    digest = contract_digest(contract)
+    model_material = _model(frozen, model, digest)
+    example_material = _examples(frozen, examples, digest)
+    _need(model_material.author_call_id != example_material.author_call_id,
+          "Model and examples must name distinct author calls; IDs do not prove independence")
+    return ReferenceBundle(frozen, model_material, example_material, digest)
