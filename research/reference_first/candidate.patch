@@ -0,0 +1,244 @@
+"""Research-only data consistency, not attestation or independent correctness.
+
+No paths are opened and no model, tool, simulator or callback is executed here.
+A trusted future adapter must obtain these normalized records from real host
+observations. Self-consistent fabricated records can pass: this is not a trust
+boundary, a provenance authority, a coverage proof or a functional RTL verdict.
+"""
+from dataclasses import dataclass
+import hashlib
+import json
+import math
+import re
+from xml.etree import ElementTree as ET
+
+MAX_XML_BYTES = 2 * 1024 * 1024
+MAX_TESTS = 1000
+_SHA = re.compile(r"[a-f0-9]{64}\Z")
+_TOP = re.compile(r"[A-Za-z_][A-Za-z0-9_]{0,127}\Z")
+_INPUT_NAMES = {"model.py", "contract.json", "examples.json", "driver.py"}
+_IDENTITY_KEYS = {"schema_version", "top", "image_id", "sources", "tests", "contract_sha256",
+                  "model_sha256", "examples_sha256", "driver_sha256", "precheck_inputs",
+                  "reference_cases", "reference_steps", "test_names"}
+_OBSERVATION_KEYS = {"version", "status", "checked_steps", "case_index", "step_index", "reason"}
+_PRECHECK_KEYS = {"schema_version", "status", "image_id", "contract_sha256", "model_sha256",
+                  "examples_sha256", "driver_sha256", "cases_count", "steps_count", "command",
+                  "observation_sha256", "observation", "input_sha256_before", "input_sha256_after"}
+
+
+class ReferenceProofError(ValueError):
+    """Fixed admission failure; no source, tool, model or XML text is echoed."""
+
+
+@dataclass(frozen=True)
+class ReferenceVerificationProof:
+    identity_sha256: str
+    xml_sha256: str
+    test_names: tuple[str, ...]
+    reference_steps: int
+    minimum_tests: int
+    evidence_sha256: str
+    assurance: str = "data_consistency_only"
+
+
+def _need(condition, code):
+    if not condition:
+        raise ReferenceProofError(code)
+
+
+def _record(value, keys, code):
+    _need(type(value) is dict and set(value) == keys, code)
+    return value
+
+
+def _integer(value, low, high, code):
+    _need(type(value) is int and low <= value <= high, code)
+    return value
+
+
+def _sha(value):
+    _need(type(value) is str and _SHA.fullmatch(value) is not None, "sha256")
+    return value
+
+
+def _hashes(value, names=None):
+    _need(type(value) is dict and 1 <= len(value) <= 128, "hash_map")
+    _need(all(type(key) is str for key in value), "hash_map")
+    if names is not None:
+        _need(set(value) == names, "hash_map_keys")
+    for sha in value.values():
+        _sha(sha)
+    return value
+
+
+def _files(value, kind):
+    _hashes(value)
+    _need(len(value) <= 64, "file_count")
+    suffix = "v" if kind == "src" else "py"
+    pattern = rf"{kind}/[A-Za-z_][A-Za-z0-9_]{{0,127}}\.{suffix}\Z"
+    _need(all(re.fullmatch(pattern, key) is not None for key in value), "file_path")
+    return value
+
+
+def _test_name(value):
+    _need(type(value) is str and 1 <= len(value) <= 256 and value == value.strip()
+          and all(ord(char) >= 32 and ord(char) != 127 for char in value), "test_name")
+    try:
+        _need(len(value.encode("utf-8")) <= 256, "test_name")
+    except UnicodeError:
+        raise ReferenceProofError("test_name") from None
+    return value
+
+
+def _identity(value, minimum):
+    v = _record(value, _IDENTITY_KEYS, "identity_fields")
+    _integer(v["schema_version"], 1, 1, "identity_version")
+    _need(type(v["top"]) is str and _TOP.fullmatch(v["top"]) is not None, "top")
+    _need(type(v["image_id"]) is str and v["image_id"].startswith("sha256:"), "image_id")
+    _sha(v["image_id"][7:])
+    _files(v["sources"], "src"); _files(v["tests"], "test")
+    for key in ("contract_sha256", "model_sha256", "examples_sha256", "driver_sha256"):
+        _sha(v[key])
+    inputs = _hashes(v["precheck_inputs"], _INPUT_NAMES)
+    _need(inputs["model.py"] == v["model_sha256"] and inputs["driver.py"] == v["driver_sha256"],
+          "precheck_input_identity")
+    cases = _integer(v["reference_cases"], 1, 32, "reference_cases")
+    _integer(v["reference_steps"], cases, min(2048, cases * 256), "reference_steps")
+    names = v["test_names"]
+    _need(type(names) is list and minimum <= len(names) <= MAX_TESTS, "test_count")
+    for name in names:
+        _test_name(name)
+    _need(len(set(names)) == len(names), "duplicate_test_name")
+    return v
+
+
+def _command(value):
+    v = _record(value, {"returncode", "timed_out", "process_launched", "duration_seconds"}, "command_fields")
+    _integer(v["returncode"], 0, 0, "command_exit")
+    _need(v["timed_out"] is False and v["process_launched"] is True, "command_not_closed_success")
+    duration = v["duration_seconds"]
+    _need(type(duration) in (int, float), "command_duration")
+    try:
+        _need(math.isfinite(duration) and duration >= 0, "command_duration")
+    except OverflowError:
+        raise ReferenceProofError("command_duration") from None
+
+
+def _observation(value, steps):
+    v = _record(value, _OBSERVATION_KEYS, "observation_fields")
+    _integer(v["version"], 1, 1, "observation_version")
+    _need(v["status"] == "passed" and type(v["status"]) is str, "precheck_not_passed")
+    _integer(v["checked_steps"], steps, steps, "precheck_step_count")
+    _need(v["case_index"] is None and v["step_index"] is None and v["reason"] is None,
+          "precheck_success_locators")
+    return v
+
+
+def _json_observation(raw):
+    _need(type(raw) is bytes and 1 <= len(raw) <= 65536, "observation_bytes")
+    def pairs(items):
+        result = {}
+        for key, value in items:
+            _need(key not in result, "duplicate_json_key")
+            result[key] = value
+        return result
+    def constant(_):
+        raise ReferenceProofError("json_constant")
+    try:
+        return json.loads(raw.decode("utf-8"), object_pairs_hook=pairs, parse_constant=constant)
+    except (UnicodeError, ValueError, RecursionError):
+        raise ReferenceProofError("observation_json") from None
+
+
+def _xml_names(raw, minimum):
+    _need(type(raw) is bytes and 1 <= len(raw) <= MAX_XML_BYTES, "xml_bytes")
+    try:
+        text = raw.decode("utf-8")
+        _need("\x00" not in text and "<!DOCTYPE" not in text.upper() and "<!ENTITY" not in text.upper(),
+              "xml_declaration")
+        root = ET.fromstring(text)
+    except (UnicodeError, ET.ParseError, RecursionError):
+        raise ReferenceProofError("xml_parse") from None
+    _need(root.tag in {"testsuites", "testsuite"}, "xml_root")
+    nodes = []; pending = [(root, None, 0)]
+    while pending:
+        node, parent, depth = pending.pop()
+        _need(depth <= 32 and len(nodes) < 8192, "xml_structure_bound")
+        nodes.append(node)
+        _need(node.tag in {"testsuites", "testsuite", "testcase", "properties", "property", "system-out", "system-err"},
+              "xml_failed_skipped_or_unknown_element")
+        if node.tag == "testcase":
+            _need(parent is not None and parent.tag == "testsuite", "xml_case_parent")
+        if node.tag == "testsuites":
+            _need(node is root, "xml_nested_root")
+        if node.tag == "testsuite" and node is not root:
+            _need(parent is not None and parent.tag in {"testsuites", "testsuite"}, "xml_suite_parent")
+        pending.extend((child, node, depth + 1) for child in reversed(list(node)))
+    cases = [node for node in nodes if node.tag == "testcase"]
+    _need(minimum <= len(cases) <= MAX_TESTS, "xml_test_count")
+    names = tuple(_test_name(case.get("name")) for case in cases)
+    _need(len(names) == len(set(names)), "xml_duplicate_test_name")
+    for node in nodes:
+        if node.tag in {"testsuite", "testsuites"}:
+            count = sum(child.tag == "testcase" for child in node.iter())
+            for key, expected in (("tests", count), ("failures", 0), ("errors", 0), ("skipped", 0)):
+                if key in node.attrib:
+                    value = node.attrib[key]
+                    _need(re.fullmatch(r"0|[1-9][0-9]{0,3}", value) is not None
+                          and int(value) == expected, "xml_summary_count")
+    return names
+
+
+def validate_reference_proof(identity, precheck, simulation, *, precheck_observation,
+                             simulator_xml, minimum_tests=4):
+    """Check normalized evidence consistency only; never create host authority.
+
+    Expected identities must be assembled independently by a trusted caller.
+    The current ordinary simulator/precheck do not yet emit this exact wrapper.
+    Artifact bytes are passed in, never loaded or executed by this function.
+    """
+    _integer(minimum_tests, 4, MAX_TESTS, "minimum_tests")
+    expected = _identity(identity, minimum_tests)
+    p = _record(precheck, _PRECHECK_KEYS, "precheck_fields")
+    _integer(p["schema_version"], 1, 1, "precheck_version")
+    _need(type(p["status"]) is str and p["status"] == "passed", "precheck_not_passed")
+    for key in ("image_id", "contract_sha256", "model_sha256", "examples_sha256", "driver_sha256"):
+        _need(type(p[key]) is str and p[key] == expected[key], "precheck_identity")
+    _integer(p["cases_count"], expected["reference_cases"], expected["reference_cases"], "precheck_case_count")
+    _integer(p["steps_count"], expected["reference_steps"], expected["reference_steps"], "precheck_step_count")
+    _command(p["command"])
+    for key in ("input_sha256_before", "input_sha256_after"):
+        _need(_hashes(p[key], _INPUT_NAMES) == expected["precheck_inputs"], "precheck_input_changed")
+    observed = _observation(_json_observation(precheck_observation), expected["reference_steps"])
+    _need(_observation(p["observation"], expected["reference_steps"]) == observed, "precheck_observation_mismatch")
+    _need(_sha(p["observation_sha256"]) == hashlib.sha256(precheck_observation).hexdigest(), "observation_hash")
+    s = _record(simulation, {"schema_version", "identity", "command", "input_sha256_before",
+                            "input_sha256_after", "xml_sha256", "result"}, "simulation_fields")
+    _integer(s["schema_version"], 1, 1, "simulation_version")
+    _need(_identity(s["identity"], minimum_tests) == expected, "simulation_identity")
+    _command(s["command"])
+    files = {**expected["sources"], **expected["tests"]}
+    for key in ("input_sha256_before", "input_sha256_after"):
+        _need(_hashes(s[key], set(files)) == files, "simulation_input_changed")
+    names = _xml_names(simulator_xml, minimum_tests)
+    _need(set(names) == set(expected["test_names"]), "xml_test_identity")
+    _need(_sha(s["xml_sha256"]) == hashlib.sha256(simulator_xml).hexdigest(), "xml_hash")
+    result = _record(s["result"], {"ok", "passed", "failed", "skipped", "cases"}, "simulation_result_fields")
+    _need(result["ok"] is True, "simulation_not_passed")
+    _integer(result["passed"], len(names), len(names), "simulation_count")
+    _integer(result["failed"], 0, 0, "simulation_failed")
+    _integer(result["skipped"], 0, 0, "simulation_skipped")
+    cases = result["cases"]
+    _need(type(cases) is list and len(cases) == len(names), "simulation_cases")
+    case_names = []
+    for case in cases:
+        case = _record(case, {"test", "ok"}, "simulation_case_fields")
+        case_names.append(_test_name(case["test"]))
+        _need(case["ok"] is True, "simulation_case_not_passed")
+    _need(len(set(case_names)) == len(case_names) and set(case_names) == set(names), "simulation_case_identity")
+    raw = json.dumps(expected, sort_keys=True, separators=(",", ":"), ensure_ascii=True, allow_nan=False).encode()
+    evidence = json.dumps({"identity": expected, "precheck": p, "simulation": s}, sort_keys=True,
+                          separators=(",", ":"), ensure_ascii=True, allow_nan=False).encode()
+    return ReferenceVerificationProof(hashlib.sha256(raw).hexdigest(), hashlib.sha256(simulator_xml).hexdigest(),
+                                      names, expected["reference_steps"], minimum_tests,
+                                      hashlib.sha256(evidence).hexdigest())
