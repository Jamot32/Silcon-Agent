+"""Public seams: bounded source/examples, literal pin values, and bundle binding.
+
+Only validate source text; generated model code is never imported or executed.
+These seams were explicitly approved for the isolated research slice.
+"""
+from copy import deepcopy
+from dataclasses import FrozenInstanceError
+
+import pytest
+
+from app.agent.reference_bundle import (
+    BundleValidationError,
+    contract_digest,
+    validate_examples,
+    validate_model,
+    validate_reference_bundle,
+)
+
+
+SOURCE = 'class Model:\n    def evaluate(self, inputs):\n        return {"y": inputs["a"] ^ inputs["b"]}\n'
+
+
+def contract():
+    return {
+        "schema_version": 1,
+        "profile": "combinational_all_known",
+        "clock_port": None,
+        "reset_port": None,
+        "ports": [
+            {"name": "a", "direction": "input", "width": 3},
+            {"name": "b", "direction": "input", "width": 3},
+            {"name": "y", "direction": "output", "width": 3},
+        ],
+    }
+
+
+def materials(c=None):
+    c = contract() if c is None else c
+    digest = contract_digest(c)
+    model = {"schema_version": 1, "contract_sha256": digest,
+             "author_call_id": "a" * 32, "source": SOURCE}
+    examples = {"schema_version": 1, "contract_sha256": digest,
+                "author_call_id": "b" * 32, "cases": [
+                    {"name": "mixed_bits", "steps": [
+                        {"inputs": {"a": 3, "b": 6}, "expected": {"y": 5}},
+                    ]},
+                ]}
+    return c, model, examples
+
+
+def test_accepts_separately_authored_literal_examples_without_running_model():
+    c, model, examples = materials()
+    bundle = validate_reference_bundle(c, model, examples)
+    assert bundle.model.source == SOURCE
+    assert bundle.examples.cases[0].steps[0].expected == (("y", 5),)
+    assert bundle.contract.profile == "combinational_all_known"
+
+
+@pytest.mark.parametrize("field,value", [
+    ("schema_version", True), ("schema_version", 2),
+    ("profile", "valid_only"), ("profile", "bounded_latency"),
+    ("profile", "async_reset"), ("profile", "wired_and"),
+    ("clock_port", "a"), ("reset_port", "b"), ("extra", "not a contract field"),
+])
+def test_contract_refuses_coercion_and_unsupported_observations(field, value):
+    c = contract()
+    c[field] = value
+    with pytest.raises(BundleValidationError):
+        validate_reference_bundle(*materials(c))
+
+
+@pytest.mark.parametrize("field,value", [
+    ("name", "../escape"), ("name", "a.b"), ("name", ""), ("name", "α"),
+    ("direction", "inout"), ("width", 0), ("width", -1), ("width", True),
+    ("width", 3.0), ("width", "3"), ("width", 1025), ("unknown", 1),
+])
+def test_ports_require_bounded_names_directions_and_integer_widths(field, value):
+    c = contract()
+    c["ports"][0][field] = value
+    with pytest.raises(BundleValidationError):
+        validate_reference_bundle(*materials(c))
+
+
+def test_duplicate_port_names_and_no_observable_output_are_rejected():
+    duplicate = contract()
+    duplicate["ports"][1]["name"] = "a"
+    no_output = contract()
+    no_output["ports"][2]["direction"] = "input"
+    for c in (duplicate, no_output):
+        with pytest.raises(BundleValidationError):
+            validate_reference_bundle(*materials(c))
+
+
+@pytest.mark.parametrize("expected", [
+    {}, {"ghost": 5}, {"a": 3, "b": 6, "y": 5}, {"y": None}, {"y": True},
+    {"y": "5"}, {"y": 5.0}, {"y": -1}, {"y": 8},
+])
+def test_expected_values_are_complete_output_only_literal_width_checks(expected):
+    c, model, examples = materials()
+    examples["cases"][0]["steps"][0]["expected"] = expected
+    with pytest.raises(BundleValidationError):
+        validate_reference_bundle(c, model, examples)
+
+
+@pytest.mark.parametrize("inputs", [{"a": 3}, {"a": 3, "b": 6, "y": 5},
+                                    {"a": 8, "b": 0}, {"a": True, "b": 0}] )
+def test_directed_inputs_are_exact_known_pins_with_literal_integer_values(inputs):
+    c, model, examples = materials()
+    examples["cases"][0]["steps"][0]["inputs"] = inputs
+    with pytest.raises(BundleValidationError):
+        validate_reference_bundle(c, model, examples)
+
+
+@pytest.mark.parametrize("which,field,value", [
+    ("model", "contract_sha256", "0" * 64),
+    ("examples", "contract_sha256", "0" * 64),
+    ("model", "author_call_id", "not-a-call"),
+    ("examples", "author_call_id", "a" * 32),
+    ("examples", "schema_version", 1.0),
+    ("model", "unknown", "not a model field"),
+])
+def test_proposals_bind_the_exact_contract_and_distinct_author_call_ids(which, field, value):
+    c, model, examples = materials()
+    (model if which == "model" else examples)[field] = value
+    with pytest.raises(BundleValidationError):
+        validate_reference_bundle(c, model, examples)
+
+
+def test_empty_duplicate_or_oversized_example_plans_are_rejected():
+    c, model, original = materials()
+    variants = []
+    for cases in ([], original["cases"] * 2, original["cases"] * 33):
+        e = deepcopy(original)
+        e["cases"] = cases
+        variants.append(e)
+    for steps in ([], original["cases"][0]["steps"] * 257):
+        e = deepcopy(original)
+        e["cases"][0]["steps"] = steps
+        variants.append(e)
+    for examples in variants:
+        with pytest.raises(BundleValidationError):
+            validate_reference_bundle(c, model, examples)
+
+
+@pytest.mark.parametrize("source", [
+    "not valid python !", "import os\n" + SOURCE,
+    "open('forbidden', 'w').write('no')\n" + SOURCE,
+    SOURCE.replace("class Model:", "class Model(object):"),
+    SOURCE.replace("class Model:", "@decorator\nclass Model:"),
+    SOURCE.replace("class Model:", "class Different:"),
+    SOURCE.replace("def evaluate(self, inputs):", "async def evaluate(self, inputs):"),
+    SOURCE.replace("def evaluate(self, inputs):", "def evaluate(self, inputs=None):"),
+    SOURCE.replace("def evaluate(self, inputs):", "def evaluate(self, inputs: dict):"),
+    SOURCE.replace("def evaluate(self, inputs):", "def evaluate(self, ports):"),
+    SOURCE.replace('inputs["a"] ^ inputs["b"]', "eval('1')"),
+    SOURCE.replace('inputs["a"] ^ inputs["b"]', "getattr(inputs, 'anything')"),
+    SOURCE.replace('inputs["a"] ^ inputs["b"]', "inputs.__class__"),
+    SOURCE.replace('inputs["a"]', 'inputs["unknown_pin"]'),
+    SOURCE.replace('{"y": inputs["a"] ^ inputs["b"]}', '{"a": 0, "y": 0}'),
+    SOURCE.replace('{"y": inputs["a"] ^ inputs["b"]}', '{}'),
+    SOURCE.replace('return {"y": inputs["a"] ^ inputs["b"]}', 'while True:\n            pass'),
+])
+def test_model_source_obeys_bounded_syntax_and_import_policy(source):
+    c, model, examples = materials()
+    model["source"] = source
+    with pytest.raises(BundleValidationError):
+        validate_reference_bundle(c, model, examples)
+
+
+def test_syntactically_admitted_model_is_not_executed_or_claimed_correct():
+    c, model, examples = materials()
+    # Validation must admit syntax without calling evaluate or inferring its value.
+    model["source"] = 'class Model:\n    def evaluate(self, inputs):\n        return {"y": 1 // 0}\n'
+    bundle = validate_reference_bundle(c, model, examples)
+    assert bundle.model.source == model["source"]
+
+
+def synchronous_materials():
+    c = contract()
+    c.update(profile="sync_active_low_all_known_after_rising_edge", clock_port="tick", reset_port="clear_n")
+    c["ports"] += [{"name": "tick", "direction": "input", "width": 1},
+                   {"name": "clear_n", "direction": "input", "width": 1}]
+    c, model, examples = materials(c)
+    model["source"] = ('class Model:\n'
+                       '    def reset(self):\n        self.state = 0\n'
+                       '    def step(self, inputs):\n'
+                       '        if inputs["clear_n"] == 0:\n            self.reset()\n'
+                       '        else:\n            self.state = inputs["a"] ^ inputs["b"]\n'
+                       '        return {"y": self.state}\n')
+    examples["cases"][0]["steps"] = [
+        {"inputs": {"a": 3, "b": 6, "clear_n": 0}, "expected": {"y": 0}},
+        {"inputs": {"a": 3, "b": 6, "clear_n": 1}, "expected": {"y": 5}},
+    ]
+    return c, model, examples
+
+
+def test_synchronous_profile_accepts_declared_roles_and_post_edge_literals():
+    bundle = validate_reference_bundle(*synchronous_materials())
+    assert bundle.contract.clock_port == "tick"
+    assert bundle.examples.cases[0].steps[0].inputs == (("a", 3), ("b", 6), ("clear_n", 0))
+
+
+def test_synchronous_examples_cannot_drive_clock_skip_reset_or_omit_reset_method():
+    for fault in ("clock", "reset", "method"):
+        c, model, examples = synchronous_materials()
+        if fault == "clock":
+            examples["cases"][0]["steps"][0]["inputs"]["tick"] = 0
+        elif fault == "reset":
+            examples["cases"][0]["steps"][0]["inputs"]["clear_n"] = 1
+        else:
+            model["source"] = SOURCE
+        with pytest.raises(BundleValidationError):
+            validate_reference_bundle(c, model, examples)
+
+
+def test_independent_material_validators_and_results_do_not_alias_input_records():
+    c, model, examples = materials()
+    assert validate_model(c, model).source == SOURCE
+    assert validate_examples(c, examples).cases[0].steps[0].expected == (("y", 5),)
+    bundle = validate_reference_bundle(c, model, examples)
+    c["ports"][0]["width"] = 12
+    model["source"] = "changed caller-owned text"
+    examples["cases"][0]["steps"][0]["expected"]["y"] = 0
+    assert bundle.contract.ports[0] == ("a", "input", 3)
+    assert bundle.model.source == SOURCE
+    assert bundle.examples.cases[0].steps[0].expected == (("y", 5),)
+    with pytest.raises(FrozenInstanceError):
+        bundle.model.source = "changed"
+
+
+def test_source_byte_bound_counts_utf8_not_characters():
+    c, model, examples = materials()
+    model["source"] = '"""' + "💡" * 8192 + '"""\n' + SOURCE
+    with pytest.raises(BundleValidationError):
+        validate_reference_bundle(c, model, examples)
+
+
+def test_source_at_exact_byte_boundary_remains_data_only():
+    c, model, examples = materials()
+    model["source"] = SOURCE + "#" + "x" * (32768 - len(SOURCE) - 1)
+    assert len(validate_model(c, model).source.encode()) == 32768
+    model["source"] += "x"
+    with pytest.raises(BundleValidationError):
+        validate_model(c, model)
+
+
+def test_wide_literal_boundary_accepts_1024_bits_but_not_the_next_bit():
+    c = contract()
+    c["ports"][2]["width"] = 1024
+    c, model, examples = materials(c)
+    literal = (1 << 1024) - 1
+    examples["cases"][0]["steps"][0]["expected"]["y"] = literal
+    assert validate_examples(c, examples).cases[0].steps[0].expected == (("y", literal),)
+    examples["cases"][0]["steps"][0]["expected"]["y"] = 1 << 1024
+    with pytest.raises(BundleValidationError):
+        validate_examples(c, examples)
+
+
+def test_serialized_example_data_has_a_byte_cap_beyond_step_count_caps():
+    c, model, examples = materials()
+    examples["cases"] = [{"name": f"case_{i}", "steps": deepcopy(examples["cases"][0]["steps"]) * 256}
+                         for i in range(8)]
+    with pytest.raises(BundleValidationError, match="bytes"):
+        validate_reference_bundle(c, model, examples)
+
+
+def test_literal_get_cannot_reference_undeclared_inputs():
+    c, model, examples = materials()
+    model["source"] = SOURCE.replace('inputs["a"]', 'inputs.get("unknown_pin", 0)')
+    with pytest.raises(BundleValidationError):
+        validate_model(c, model)
+
+
+@pytest.mark.parametrize("section", ["contract", "model", "examples"])
+@pytest.mark.parametrize("value", [None, [], "not an object"])
+def test_records_never_coerce_non_object_inputs(section, value):
+    c, model, examples = materials()
+    values = {"contract": c, "model": model, "examples": examples}
+    values[section] = value
+    with pytest.raises(BundleValidationError):
+        validate_reference_bundle(values["contract"], values["model"], values["examples"])
+
+
+@pytest.mark.parametrize("body", [
+    'break\n        return {"y": 0}',
+    'continue\n        return {"y": 0}',
+    'for value in range(1):\n            pass\n        else:\n            break\n        return {"y": 0}',
+    'class Nested:\n            pass\n        return {"y": 0}',
+    'alias = inputs\n        return {"y": alias["ghost"]}',
+    'self.alias = inputs\n        return {"y": self.alias["ghost"]}',
+    'alias = dict(inputs)\n        return {"y": alias["ghost"]}',
+    'alias = inputs.copy()\n        return {"y": alias["ghost"]}',
+    'getter = inputs.get\n        return {"y": 0}',
+    'inputs["a"] = 0\n        return {"y": 0}',
+    'if inputs["a"]:\n            return {"y": 0}',
+    'for value in range(1):\n            return {"y": value}',
+])
+def test_static_admission_rejects_nested_definitions_input_aliases_and_fallthrough(body):
+    c, model, examples = materials()
+    model["source"] = 'class Model:\n    def evaluate(self, inputs):\n        ' + body + '\n'
+    with pytest.raises(BundleValidationError):
+        validate_reference_bundle(c, model, examples)
+
+
+@pytest.mark.parametrize("body", [
+    'value = inputs["a"]\n        for bit in range(3):\n            if bit == 1:\n                continue\n            if bit == 2:\n                break\n        return {"y": value}',
+    'if inputs.get("a", 0):\n            return {"y": 1}\n        else:\n            return {"y": 0}',
+    'if inputs["a"]:\n            return {"y": 1}\n        return {"y": 0}',
+])
+def test_static_admission_keeps_literal_pin_reads_and_conservative_total_return_forms(body):
+    c, model, examples = materials()
+    model["source"] = 'class Model:\n    def evaluate(self, inputs):\n        ' + body + '\n'
+    assert validate_reference_bundle(c, model, examples).model.source == model["source"]
+
+
+def test_optional_helper_rejects_duplicate_parameter_names_without_compiling():
+    c, model, examples = materials()
+    model["source"] = ('class Model:\n'
+                       '    def combine(self, value, value):\n        return value\n'
+                       '    def evaluate(self, inputs):\n        return {"y": 0}\n')
+    with pytest.raises(BundleValidationError):
+        validate_reference_bundle(c, model, examples)
+
+
+def test_optional_helper_keeps_distinct_parameters_and_literal_input_reads():
+    c, model, examples = materials()
+    model["source"] = ('class Model:\n'
+                       '    def combine(self, left, right):\n        return left ^ right\n'
+                       '    def evaluate(self, inputs):\n'
+                       '        return {"y": self.combine(inputs["a"], inputs["b"])}\n')
+    assert validate_reference_bundle(c, model, examples).model.source == model["source"]
+
+
+def test_deep_expression_within_node_budget_never_raises_raw_recursion_error():
+    c, model, examples = materials()
+    # Parsed/validated as data only: this expression is never evaluated.
+    expression = " + ".join(["1"] * 1100)
+    model["source"] = ('class Model:\n    def evaluate(self, inputs):\n'
+                       '        return {"y": ' + expression + '}\n')
+    assert validate_reference_bundle(c, model, examples).model.source == model["source"]
