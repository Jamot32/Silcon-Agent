+def test_log_close_failure_cannot_mask_cancelled_error(tmp_path, monkeypatch, phase):
+    from pathlib import Path
+    async def scenario():
+        started = asyncio.Event(); release = asyncio.Event(); closed = []; commands = []
+        class Child:
+            returncode = None
+            def kill(self): self.returncode = -9
+            async def wait(self):
+                if phase == 'wait': started.set()
+                if self.returncode is None: await asyncio.Future()
+                return self.returncode
+        class Cleanup:
+            returncode = 0
+            async def wait(self): return 0
+        async def spawn(*args, **kwargs):
+            commands.append(args)
+            if args[:2] == ('docker', 'run'):
+                if phase == 'launch': started.set(); await release.wait()
+                return Child()
+            return Cleanup()
+        actual_open = Path.open
+        class FaultLog:
+            def __init__(self, wrapped): self.wrapped = wrapped
+            def __enter__(self): self.wrapped.__enter__(); return self
+            def __exit__(self, *args):
+                self.wrapped.__exit__(*args); closed.append(True)
+                raise OSError('synthetic close failure')
+            def write(self, data): return self.wrapped.write(data)
+            def flush(self): return self.wrapped.flush()
+        def opening(path, mode='r', *args, **kwargs):
+            result = actual_open(path, mode, *args, **kwargs)
+            return FaultLog(result) if path.name == 'tool.log' and mode == 'wb' else result
+        monkeypatch.setattr(asyncio, 'create_subprocess_exec', spawn)
+        monkeypatch.setattr(Path, 'open', opening)
+        task = asyncio.create_task(DockerSandbox().run(['true'], input_dir=tmp_path, output_dir=tmp_path/'out', timeout=3))
+        await started.wait(); task.cancel(); await asyncio.sleep(0); release.set()
+        with pytest.raises(asyncio.CancelledError) as caught: await task
+        assert closed == [True]
+        assert any('log close failed' in note for note in getattr(caught.value, '__notes__', []))
+        name = commands[0][commands[0].index('--name')+1]
+        assert commands[1] == ('docker', 'rm', '-f', name)
+    asyncio.run(scenario())
