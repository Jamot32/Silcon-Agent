  "request": {
    "spec_text": "Build a small synchronous Gray-code position counter. Use inputs clk, rst_n, enable, reverse, and clear; outputs position[3:0], gray[3:0], and wrap. All inputs are sampled on rising clk. The reset is synchronous active-low. Reset or clear sets position=0 and wrap=0, overriding everything. When enabled, increment position modulo16 if reverse=0, or decrement modulo16 if reverse=1. wrap is a one-cycle pulse only on enabled15-to-0 or0-to-15 transitions; it is0 on every hold or clear cycle. gray must always equal position XOR(position shifted right1). No output is tri-stated. Target50MHz in a1x1 tile.",
    "targets": {
      "clock_mhz": 50,
      "fit": "tt_1x1_tile"
    }
  },
