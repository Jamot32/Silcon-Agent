    {
      "id": "rec_t",
      "type": "text",
      "x": 837.4,
      "y": 1000,
      "width": 865.2,
      "height": 112.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
