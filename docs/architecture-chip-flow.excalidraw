      "versionNonce": 129053593,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793821008804,
      "link": null,
      "locked": false,
      "text": "Deterministic recovery  (agent/recovery.py: failure_class → bounded action)\ntiming_fail → relax clock within user floor (+10%, or WNS × 1.25) → SYNTH_STRATEGY DELAY 0 → RTL repair\ndie_too_small / congestion / placement / electrical → adjust density, grow die 15% (≤2 tries)\ndrc_fail → one retry at density −5% (floor 30%)\ngate_level_mismatch → RTL repair (reset every register, no X-dependence)\nflow_timeout → scope down            anything else → stop, keep diagnostics",
      "originalText": "Deterministic recovery  (agent/recovery.py: failure_class → bounded action)\ntiming_fail → relax clock within user floor (+10%, or WNS × 1.25) → SYNTH_STRATEGY DELAY 0 → RTL repair\ndie_too_small / congestion / placement / electrical → adjust density, grow die 15% (≤2 tries)\ndrc_fail → one retry at density −5% (floor 30%)\ngate_level_mismatch → RTL repair (reset every register, no X-dependence)\nflow_timeout → scope down            anything else → stop, keep diagnostics",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "rec",
      "lineHeight": 1.25,
      "autoResize": true,
      "index": "ay"
    },
